      22: Text { content: "Egypt" }
      23: Text { content: " for naught; the cucumbers, and the melons, and the leeks, and the onions, and the garlic.”" }
      24: EndParagraph
      25: StartParagraph { alignment: None, id: None }
      26: Text { content: "The thing is that" }
