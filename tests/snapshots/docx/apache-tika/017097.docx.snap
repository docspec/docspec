    1003: StartParagraph { alignment: None, id: None }
    1004: LineBreak
    1005: StartTextStyle { kind: Bold, id: None }
    1006: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1007: Text { content: "How You Will Be Evaluated:" }
    1008: EndTextStyle
    1009: EndTextStyle
    1010: EndParagraph
    1011: EndTableCell
    1012: EndTableRow
    1013: StartTableRow { id: None }
    1014: StartTableCell { colspan: None, id: None, rowspan: None }
    1015: StartParagraph { alignment: None, id: None }
    1016: Text { content: "Please ensure you answer all questions and follow all instructions carefully.\u{a0} Errors or omissions may affect your evaluation.\u{a0} When answering the questionnaire, remember that your experience and education are subject to verification by investigation.\u{a0} You may be asked to provide specific examples or documentation of experience or education as proof to support your answers, or you may be required to verify a response by a practical demonstration of your claimed ability to perform a task." }
    1017: EndParagraph
    1018: EndTableCell
    1019: EndTableRow
