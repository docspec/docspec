    1785: LineBreak
    1786: LineBreak
    1787: StartTextStyle { kind: Bold, id: None }
    1788: Text { content: "24. Personal Background Information" }
    1789: EndTextStyle
    1790: LineBreak
    1791: LineBreak
    1792: Text { content: "If you are applying by the OPM Form 1203-FX, leave this section blank." }
    1793: LineBreak
    1794: LineBreak
    1795: StartTextStyle { kind: Bold, id: None }
    1796: Text { content: "25. Occupational/Assessment Questions:" }
    1797: EndTextStyle
    1798: Text { content: " " }
    1799: EndParagraph
    1800: StartParagraph { alignment: None, id: None }
    1801: Text { content: "1. Select the one statement below that best describes your experience, education or combination of experience and education to meet the basic requirements for this position." }
    1802: EndParagraph
    1803: StartParagraph { alignment: None, id: None }
    1804: Text { content: "A. At least one year of specialized experience equivalent to the next lower grade level (GS-6) with responsibilities close to the work of this position that has given you the particular knowledge, skills, and abilities required to successfully perform the duties of this position." }
    1805: LineBreak
    1806: Text { content: "B. General experience in a progressively responsible clerical, office, or other position that indicates your ability to acquire the particular knowledge and skills needed to perform the duties of this position." }
    1807: LineBreak
    1808: Text { content: "C. None of the above." }
    1809: EndParagraph
    1810: StartParagraph { alignment: None, id: None }
    1811: Text { content: "2. For the following item, choose the ONE statement from the list below that best describes your typing and office automation abilities." }
    1812: EndParagraph
    1813: StartParagraph { alignment: None, id: None }
    1814: Text { content: "A. I type at least 40 words per minute with no more than three errors." }
    1815: LineBreak
    1816: Text { content: "B. I type less than 40 words per minute." }
    1817: EndParagraph
    1818: StartParagraph { alignment: None, id: None }
    1819: Text { content: "Please indicate either Yes or No for the following statement(s). If a narrative response is required, it must be provided in the allotted space, or if you are submitting a hard copy application - on a separate sheet of paper." }
    1820: EndParagraph
    1821: StartParagraph { alignment: None, id: None }
    1822: Text { content: "A- Yes" }
    1823: LineBreak
    1824: Text { content: "B- No" }
    1825: EndParagraph
    1826: StartParagraph { alignment: None, id: None }
    1827: Text { content: "3. I have experience and knowledge of the research process and research funding mechanisms requirements." }
    1828: EndParagraph
    1829: StartParagraph { alignment: None, id: None }
    1830: Text { content: "If you answered \"yes\" to the above statement, please give examples of your experience and knowledge of the research process and research funding mechanisms requirements. What was your job title and major job duties?" }
    1831: EndParagraph
    1832: StartParagraph { alignment: None, id: None }
    1833: Text { content: "For the following item(s), choose the ONE statement from the list below that best describes your experience and/or training. Please select only one letter for each item. Some may require additional information or examples which must be provided in the allotted space, or if you are submitting a hard copy application - on a separate sheet of paper." }
    1834: EndParagraph
    1835: StartParagraph { alignment: None, id: None }
    1836: Text { content: "A- I am considered an expert in performing this task." }
    1837: LineBreak
    1838: Text { content: "B- I have successfully performed this task as a regular part of a job." }
    1839: LineBreak
    1840: Text { content: "C- I have occasionally performed this task as part of a job." }
    1841: LineBreak
    1842: Text { content: "D- I have received training in this area, but have not performed it on the job." }
    1843: LineBreak
    1844: Text { content: "E- I have not had training or experience in performing this task." }
    1845: EndParagraph
    1846: StartParagraph { alignment: None, id: None }
    1847: Text { content: "4. Ability to transcribe meeting minutes and reports." }
    1848: EndParagraph
    1849: StartParagraph { alignment: None, id: None }
    1850: Text { content: "Please provide details of your transcription experience. What types of reports or meeting were you responsible for transcribing?" }
    1851: EndParagraph
    1852: StartParagraph { alignment: None, id: None }
    1853: Text { content: "5. Utilizing medical and/or scientific terminology." }
    1854: EndParagraph
    1855: StartParagraph { alignment: None, id: None }
    1856: Text { content: "Please provide details about your knowledge and experience using terminology associated with a medical research environment." }
    1857: EndParagraph
    1858: StartParagraph { alignment: None, id: None }
    1859: Text { content: "6. Coordinating grant proposal and report submissions." }
    1860: EndParagraph
    1861: StartParagraph { alignment: None, id: None }
    1862: Text { content: "Please provide information to support your answer including details about the types of grant proposals and reports and your role in preparing and/or submitting them." }
    1863: EndParagraph
    1864: StartParagraph { alignment: None, id: None }
    1865: Text { content: "7. Operating a personal computer and office automation equipment." }
    1866: EndParagraph
    1867: StartParagraph { alignment: None, id: None }
    1868: Text { content: "Please provide information to support your answer. Include examples of the type(s) of software youve used (word processing, spreadsheet, database, etc.), how it was used, and your perceived skill level (expert, highly skilled, average, beginner). Also, list the different office equipment (printers, scanners, fax machine, copier) you have used." }
    1869: EndParagraph
    1870: StartParagraph { alignment: None, id: None }
    1871: Text { content: "8. Communicating with people from varied backgrounds and different levels of an organization." }
    1872: EndParagraph
    1873: StartParagraph { alignment: None, id: None }
    1874: Text { content: "Please provide detailed examples of your experience dealing with individuals from different backgrounds, on the phone and in person, with varying levels of understanding." }
    1875: EndParagraph
    1876: StartParagraph { alignment: None, id: None }
    1877: Text { content: "9. Communicating in writing." }
    1878: EndParagraph
    1879: StartParagraph { alignment: None, id: None }
    1880: Text { content: "Please provide information to support your answer regarding your written communication skills. Describe your experience, if applicable, writing instructions, and preparing reports and correspondence from rough drafts. What steps did you follow to ensure accuracy in grammar, punctuation and spelling?" }
    1881: EndParagraph
    1882: StartParagraph { alignment: None, id: None }
    1883: Text { content: "For the following item(s), choose the ONE statement from the list below that best describes your experience and/or training. Please select only one letter for each item." }
    1884: EndParagraph
    1885: StartParagraph { alignment: None, id: None }
    1886: Text { content: "A- I have not had training or experience in performing this task." }
    1887: LineBreak
    1888: Text { content: "B- I have training in this task, but have not performed it on the job." }
    1889: LineBreak
    1890: Text { content: "C- I have occasionally performed this task on the job." }
    1891: LineBreak
    1892: Text { content: "D- I have performed this task as a regular part of a job" }
    1893: LineBreak
    1894: Text { content: "E- I am considered an expert in performing this task." }
    1895: EndParagraph
    1896: StartParagraph { alignment: None, id: None }
    1897: Text { content: "10. Analyze and interpret complex information." }
    1898: EndParagraph
    1899: StartParagraph { alignment: None, id: None }
    1900: Text { content: "11. Use judgment in selecting and utilizing procedural guidelines, such as manuals and agency training correspondence, style manuals, etc." }
    1901: EndParagraph
    1902: StartParagraph { alignment: None, id: None }
    1903: Text { content: "12. Oversee the content, format, and timeliness of grant submissions." }
    1904: EndParagraph
    1905: StartParagraph { alignment: None, id: None }
    1906: Text { content: "13. Coordinate professional meetings." }
    1907: EndParagraph
    1908: StartParagraph { alignment: None, id: None }
    1909: Text { content: "14. Establishes and maintains others calendar." }
    1910: EndParagraph
    1911: StartParagraph { alignment: None, id: None }
    1912: Text { content: "15. Identify and resolve problems with grant submissions." }
    1913: EndParagraph
    1914: StartParagraph { alignment: None, id: None }
    1915: Text { content: "16. Manage several assignments simultaneously." }
    1916: EndParagraph
    1917: StartParagraph { alignment: None, id: None }
    1918: Text { content: "17. Perform data collection." }
    1919: EndParagraph
    1920: StartParagraph { alignment: None, id: None }
    1921: Text { content: "18. Oversee data collection." }
    1922: EndParagraph
    1923: StartParagraph { alignment: None, id: None }
    1924: Text { content: "19. Develop simple databases." }
    1925: EndParagraph
    1926: StartParagraph { alignment: None, id: None }
    1927: Text { content: "20. Produce tables, graphs and/or slides for presentation." }
    1928: EndParagraph
    1929: StartParagraph { alignment: None, id: None }
    1930: Text { content: "21. Search files, documents or other sources for information." }
    1931: EndParagraph
    1932: StartParagraph { alignment: None, id: None }
    1933: Text { content: "22. Explain basic policies or procedures." }
    1934: EndParagraph
    1935: StartParagraph { alignment: None, id: None }
    1936: Text { content: "23. Provide guidance or assistance on policies or procedures." }
    1937: EndParagraph
    1938: StartParagraph { alignment: None, id: None }
    1939: Text { content: "24. Review content of letters or other documents for completeness, correctness, or consistency." }
    1940: EndParagraph
    1941: StartParagraph { alignment: None, id: None }
    1942: Text { content: "You must now complete and submit additional application materials (by Wednesday, July 30, 2008)\u{a0}as required by this vacancy announcement via uploading or faxing this information.\u{a0} To fax application materials, refer to the instructions in Alternative Methods for Completing the Application Package after Step\u{a0}3 of this vacancy announcement.\u{a0} " }
    1943: EndParagraph
    1944: StartParagraph { alignment: None, id: None }
    1945: StartTextStyle { kind: Bold, id: None }
    1946: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 192 }), id: None }
