     647: StartTableCell { colspan: None, id: None, rowspan: None }
     648: StartParagraph { alignment: None, id: None }
     649: Image { alt: Some(""), decorative: false, id: None, title: None, asset: AssetDescriptor { asset_id: "zip://word/media/image6.png", content_type: "image/png", bytes: 122, sha256: "4ea80f3af52cd347d37562d2c3e644aa355dad8c4df11e8dd25fbd0119e521ba" } }
     650: EndParagraph
     651: EndTableCell
     652: StartTableCell { colspan: None, id: None, rowspan: None }
     653: StartParagraph { alignment: None, id: None }
     654: Image { alt: Some(""), decorative: false, id: None, title: None, asset: AssetDescriptor { asset_id: "zip://word/media/image6.png", content_type: "image/png", bytes: 122, sha256: "4ea80f3af52cd347d37562d2c3e644aa355dad8c4df11e8dd25fbd0119e521ba" } }
     655: EndParagraph
     656: EndTableCell
     657: StartTableCell { colspan: None, id: None, rowspan: None }
     658: StartTable { id: None }
     659: StartTableRow { id: None }
     660: StartTableCell { colspan: None, id: None, rowspan: None }
     661: StartParagraph { alignment: None, id: None }
     662: LineBreak
     663: StartTextStyle { kind: Bold, id: None }
     664: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     665: Text { content: "Major Duties:" }
     666: EndTextStyle
     667: EndTextStyle
     668: EndParagraph
     669: EndTableCell
     670: EndTableRow
     671: StartTableRow { id: None }
     672: StartTableCell { colspan: None, id: None, rowspan: None }
     673: StartParagraph { alignment: None, id: None }
     674: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     675: Text { content: "The Program Support Assistant (Office Automation) facilitates the flow of information concerning research projects among the many elements of the Medical Research Service, e.g., the individual investigator, reviewers and/or collaborators, the Research and Development Committee and subcommittees, the ACOS for R&D and his staff, VA Central Office and its adjuncts such as the Biomedical Engineering and Computing Center, Sepulveda, and non-VA facilities such as SUNYAB." }
     676: EndTextStyle
     677: EndParagraph
     678: StartParagraph { alignment: None, id: None }
     679: Text { content: "\t" }
     680: EndParagraph
     681: StartParagraph { alignment: None, id: None }
     682: Text { content: "The majority of this information flow pertains to research grant applications, but a large fraction involves progress reports, R&D Committee communications and computer entries into the national Research and Development Information System (RDIS).  The major duties and responsibilities include: " }
     683: EndParagraph
     684: StartParagraph { alignment: None, id: None }
     685: EndParagraph
     686: StartParagraph { alignment: None, id: None }
     687: Text { content: "\t" }
     688: Text { content: "\t" }
     689: Text { content: "\u{f0b7}" }
     690: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     691: Text { content: "\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0} " }
     692: EndTextStyle
     693: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     694: Text { content: "Helps investigators prepare proposal forms, monitors each research proposal from its initial submission for consideration by committees of the Research and Development Service through its annual progress reports up to the point the project is completed; reviews each proposal for conformance with policies, regulations, format, completeness and accuracy; " }
     695: EndTextStyle
     696: EndParagraph
     697: StartParagraph { alignment: None, id: None }
     698: Text { content: "\t" }
     699: Text { content: "\t" }
     700: Text { content: "\u{f0b7}" }
     701: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     702: Text { content: "\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0} " }
     703: EndTextStyle
     704: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     705: Text { content: "Establishes agendas for the Research and Development Committee, the Human Studies Subcommittee and the Animal Studies Subcommittee meetings; " }
     706: EndTextStyle
     707: EndParagraph
     708: StartParagraph { alignment: None, id: None }
     709: Text { content: "\t" }
     710: Text { content: "\t" }
     711: Text { content: "\u{f0b7}" }
     712: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     713: Text { content: "\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0} " }
     714: EndTextStyle
     715: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     716: Text { content: "Prepares or coordinates preparation of monthly packages for all members of the committees; schedules meetings of these committees; takes notes of the proceedings; converts the notes into formal minutes; prepares these minutes for the chairperson’s review and signature; and distributes them;" }
     717: EndTextStyle
     718: EndParagraph
     719: StartParagraph { alignment: None, id: None }
     720: Text { content: "\t" }
     721: Text { content: "\t" }
     722: Text { content: "\u{f0b7}" }
     723: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     724: Text { content: "\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0} " }
     725: EndTextStyle
     726: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     727: Text { content: "Monitors each project for the required initial, progress and final reports; notifies the investigators of the need for such reports, incorporates these reports into the project package; initiates and maintains a file of all abstracts and publications resulting from work on each proposal; obtains reviews of these items and prepares copies of them for distribution;" }
     728: EndTextStyle
     729: EndParagraph
     730: StartParagraph { alignment: None, id: None }
     731: Text { content: "\t" }
     732: Text { content: "\t" }
     733: Text { content: "\u{f0b7}" }
     734: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     735: Text { content: "\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0} " }
     736: EndTextStyle
     737: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     738: Text { content: "Manages all project data activities utilizing the PROMISE system;" }
     739: EndTextStyle
     740: EndParagraph
     741: StartParagraph { alignment: None, id: None }
     742: Text { content: "\t" }
     743: Text { content: "\t" }
     744: Text { content: "\u{f0b7}" }
     745: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     746: Text { content: "\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0} " }
     747: EndTextStyle
     748: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     749: Text { content: "Acts on requests for information from potential grant applicants by answering questions related to procedure, providing copies of application forms and instructions, and reviewing with them the major requirements that need emphasis (after verifying that they are eligible to apply);" }
     750: EndTextStyle
     751: EndParagraph
     752: StartParagraph { alignment: None, id: None }
     753: Text { content: "\t" }
     754: Text { content: "\t" }
     755: Text { content: "\u{f0b7}" }
     756: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     757: Text { content: "\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0} " }
     758: EndTextStyle
     759: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     760: Text { content: "Establishes and maintains a personal calendar as a reminder of various grant deadlines both local and national as well as notation of action dates for initial submission of material or follow-up; and" }
     761: EndTextStyle
     762: EndParagraph
     763: StartParagraph { alignment: None, id: None }
     764: Text { content: "\t" }
     765: Text { content: "\t" }
     766: Text { content: "\u{f0b7}" }
     767: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     768: Text { content: "\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0} " }
     769: EndTextStyle
     770: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     771: Text { content: "Performs other duties as assigned." }
     772: EndTextStyle
     773: EndParagraph
     774: StartParagraph { alignment: None, id: None }
     775: Text { content: "\t" }
     776: Text { content: "\t" }
     777: Text { content: "\u{a0}" }
     778: EndParagraph
     779: StartParagraph { alignment: None, id: None }
     780: Text { content: "\u{a0}" }
     781: StartTextStyle { kind: Bold, id: None }
     782: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 255 }), id: None }
     783: Text { content: "***RELOCATION EXPENSES AND/OR INCENTIVES ARE NOT AUTHORIZED***\u{a0}" }
     784: EndTextStyle
     785: EndTextStyle
     786: EndParagraph
     787: EndTableCell
     788: EndTableRow
     789: EndTable
