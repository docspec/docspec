     467: Text { content: " your documentation, the\u{a0}" }
     468: EndTextStyle
     469: StartLink { href: "http://staffing.opm.gov/pdf/usascover.pdf", id: None, title: None }
     470: StartTextStyle { kind: Underline, id: None }
     471: StartTextStyle { kind: TextColor(Rgb { b: 102, g: 0, r: 0 }), id: None }
     472: Text { content: "United States Application\u{a0}Cover Page" }
     473: EndTextStyle
     474: EndTextStyle
     475: EndLink
     476: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     477: Text { content: " " }
     478: EndTextStyle
     479: StartTextStyle { kind: Bold, id: None }
     480: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 255 }), id: None }
     481: Text { content: "must" }
     482: EndTextStyle
     483: EndTextStyle
     484: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     485: Text { content: " be used in order to link your documents with your on-line questionnaire.\u{a0} Failure to provide\u{a0}this cover page - or the use of a different cover page - will prohibit your documentation from being processed.\u{a0} (see Step 3 for url)" }
     486: EndTextStyle
     487: EndParagraph
     488: StartParagraph { alignment: None, id: None }
     489: StartTextStyle { kind: Bold, id: None }
     490: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     491: Text { content: "_____" }
     492: EndTextStyle
     493: EndTextStyle
     494: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     495: Text { content: " If a particular level of education/certification is required OR if you are asking us to qualify you based upon your education, you must submit a copy of your college transcript or an appropriate course listing. (see Step 3)" }
     496: EndTextStyle
     497: EndParagraph
     498: StartParagraph { alignment: None, id: None }
     499: StartTextStyle { kind: Bold, id: None }
     500: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     501: Text { content: "_____" }
     502: EndTextStyle
     503: EndTextStyle
     504: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     505: Text { content: " Veterans must provide a\u{a0}" }
     506: EndTextStyle
     507: StartTextStyle { kind: Italic, id: None }
     508: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     509: Text { content: "legible" }
     510: EndTextStyle
     511: EndTextStyle
     512: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     513: Text { content: "\u{a0}copy of\u{a0}DD-214(s) showing all dates of service as well as character of service (honorable, general, etc.).\u{a0} Note:\u{a0} More than one DD-214 may be needed to show all dates of service. (see Step 3)" }
     514: EndTextStyle
     515: EndParagraph
     516: StartParagraph { alignment: None, id: None }
     517: StartTextStyle { kind: Bold, id: None }
     518: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     519: Text { content: "_____" }
     520: EndTextStyle
     521: EndTextStyle
     522: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     523: Text { content: "\u{a0} Disabled veterans and other veterans eligible for 10-point preference must also submit an SF-15 (version December 2004) with required proof as stated on the form. (see Step 3)" }
     524: EndTextStyle
     525: EndParagraph
     526: StartParagraph { alignment: None, id: None }
     527: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     528: Text { content: "_____\u{a0} An OF-306, Declaration for Federal Employment (version dated January 2001 or later) must be submitted prior to appointment.\u{a0} You may include this form as part of your application documents.\u{a0} It is available at " }
     529: EndTextStyle
     530: StartLink { href: "http://www.opm.gov/forms/pdf_fill_of0306.pdf", id: None, title: None }
     531: StartTextStyle { kind: Underline, id: None }
     532: StartTextStyle { kind: TextColor(Rgb { b: 102, g: 0, r: 0 }), id: None }
     533: Text { content: "www.opm.gov/forms/pdf_fill_of0306.pdf" }
     534: EndTextStyle
     535: EndTextStyle
     536: EndLink
     537: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     538: Text { content: " ." }
     539: EndTextStyle
     540: EndParagraph
