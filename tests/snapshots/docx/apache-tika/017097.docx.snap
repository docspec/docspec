    1091: StartParagraph { alignment: None, id: None }
    1092: Image { alt: Some(""), decorative: false, id: None, title: None, asset: AssetDescriptor { asset_id: "zip://word/media/image6.png", content_type: "image/png", bytes: 122, sha256: "4ea80f3af52cd347d37562d2c3e644aa355dad8c4df11e8dd25fbd0119e521ba" } }
