    2172: Text { content: "MUST" }
    2173: EndTextStyle
    2174: Text { content: " use the special cover page. Print the pre-populated cover page on the upload documents screen of Application Manager. Or, you may click this link " }
    2175: StartLink { href: "http://staffing.opm.gov/pdf/usascover.pdf", id: None, title: None }
    2176: StartTextStyle { kind: Underline, id: None }
    2177: StartTextStyle { kind: TextColor(Rgb { b: 102, g: 0, r: 0 }), id: None }
    2178: Text { content: "http://staffing.opm.gov/pdf/usascover.pdf" }
    2179: EndTextStyle
    2180: EndTextStyle
    2181: EndLink
    2182: Text { content: " to print a blank copy of the cover page. When faxing documents, follow the procedures outlined below.   " }
    2183: EndParagraph
    2184: StartParagraph { alignment: None, id: None }
    2185: EndParagraph
    2186: EndUnorderedListItem
    2187: StartUnorderedListItem { id: Some("7"), level: 0, style_type: Disc }
    2188: StartParagraph { alignment: None, id: None }
    2189: Text { content: "Include the 8-character Vacancy Identification Number " }
    2190: Text { content: "VN201385" }
    2191: Text { content: " " }
    2192: EndParagraph
    2193: EndUnorderedListItem
    2194: StartUnorderedListItem { id: Some("7"), level: 0, style_type: Disc }
    2195: StartParagraph { alignment: None, id: None }
    2196: Text { content: "Provide your Social Security Number and full name in the spaces provided or we will not be able to associate your document(s) with the rest of your application. " }
    2197: EndParagraph
    2198: EndUnorderedListItem
    2199: StartUnorderedListItem { id: Some("7"), level: 0, style_type: Disc }
    2200: StartParagraph { alignment: None, id: None }
    2201: Text { content: "You may submit multiple documents for the same vacancy announcement using one cover page." }
    2202: Text { content: " " }
    2203: EndParagraph
    2204: EndUnorderedListItem
    2205: StartUnorderedListItem { id: Some("7"), level: 0, style_type: Disc }
    2206: StartParagraph { alignment: None, id: None }
    2207: Text { content: "Fax your cover page and documents to " }
    2208: StartTextStyle { kind: Bold, id: None }
    2209: Text { content: "1-478-757-3144" }
    2210: EndTextStyle
    2211: Text { content: ". " }
    2212: EndParagraph
    2213: StartParagraph { alignment: None, id: None }
    2214: EndParagraph
    2215: StartParagraph { alignment: None, id: None }
    2216: StartTextStyle { kind: Bold, id: None }
    2217: Text { content: "Faxed documents submitted with missing information will not be processed." }
    2218: EndTextStyle
    2219: Text { content: " The following will prevent your documents from being processed:  " }
    2220: EndParagraph
    2221: StartParagraph { alignment: None, id: None }
    2222: EndParagraph
    2223: EndUnorderedListItem
    2224: StartUnorderedListItem { id: Some("8"), level: 0, style_type: Disc }
    2225: StartParagraph { alignment: None, id: None }
    2226: Text { content: "Not using the special cover page mentioned above. " }
    2227: EndParagraph
    2228: EndUnorderedListItem
    2229: StartUnorderedListItem { id: Some("8"), level: 0, style_type: Disc }
    2230: StartParagraph { alignment: None, id: None }
    2231: Text { content: "Missing, incomplete, or invalid Vacancy Identification Number " }
    2232: EndParagraph
    2233: EndUnorderedListItem
    2234: StartUnorderedListItem { id: Some("8"), level: 0, style_type: Disc }
    2235: StartParagraph { alignment: None, id: None }
    2236: Text { content: "Missing or incomplete Social Security Number or name" }
    2237: EndParagraph
    2238: StartParagraph { alignment: None, id: None }
    2239: EndParagraph
    2240: StartParagraph { alignment: None, id: None }
    2241: StartTextStyle { kind: Bold, id: None }
    2242: Text { content: "Note:" }
    2243: EndTextStyle
    2244: Text { content: " If you have documents in your Application Manager account from a previous vacancy announcement they can be opened, copied and saved then reused as an upload file for this vacancy. Uploading your documents will speed the processing of your application for this announcement. " }
    2245: EndParagraph
    2246: StartParagraph { alignment: None, id: None }
    2247: Text { content: "\u{a0}" }
    2248: EndParagraph
    2249: StartParagraph { alignment: None, id: None }
    2250: StartTextStyle { kind: Bold, id: None }
    2251: Text { content: "Be sure to complete\u{a0}all THREE STEPS of the application\u{a0}process described above in order to submit a complete application package and receive consideration for this position.\u{a0} " }
    2252: EndTextStyle
    2253: EndParagraph
    2254: StartParagraph { alignment: None, id: None }
    2255: Text { content: "\u{a0}" }
    2256: EndParagraph
    2257: StartParagraph { alignment: None, id: None }
    2258: EndParagraph
    2259: StartParagraph { alignment: Some(Center), id: None }
    2260: StartTextStyle { kind: Bold, id: None }
    2261: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 192 }), id: None }
    2262: Text { content: "ALTERNATIVE METHODS FOR COMPLETING THE\u{a0}APPLICATION PACKAGE" }
    2263: EndTextStyle
    2264: EndTextStyle
    2265: EndParagraph
    2266: StartParagraph { alignment: None, id: None }
    2267: Text { content: "To Complete the\u{a0}Assessment Questionnaire manually, you will need a copy of the answer sheet, referred to as the Occupational Questionnaire\u{a0}- " }
    2268: StartTextStyle { kind: Bold, id: None }
    2269: Text { content: "OPM Form 1203-FX" }
    2270: EndTextStyle
    2271: Text { content: " which can be obtained electronically at" }
    2272: EndParagraph
    2273: StartParagraph { alignment: None, id: None }
    2274: StartTextStyle { kind: Bold, id: None }
    2275: Text { content: "Error! Hyperlink reference not valid." }
    2276: EndTextStyle
    2277: Text { content: " ;" }
    2278: EndParagraph
    2279: StartParagraph { alignment: None, id: None }
    2280: Text { content: "or by calling USAJOBS at\u{a0}703-724-1850;\u{a0}follow the instructions given;" }
    2281: EndParagraph
    2282: StartParagraph { alignment: None, id: None }
    2283: Text { content: "or by visiting the Human Resources Management Service of the VA Medical Center at the duty location.\u{a0} " }
    2284: EndParagraph
    2285: StartParagraph { alignment: None, id: None }
    2286: Text { content: "You will also need a copy of the\u{a0}vacancy announcement to use as a guide in answering the questions.\u{a0} You " }
    2287: StartTextStyle { kind: Bold, id: None }
    2288: Text { content: "must " }
    2289: EndTextStyle
    2290: Text { content: "provide responses\u{a0}to all required questions. Some questions may request an additional written response to support your answer, such as " }
    2291: StartTextStyle { kind: Italic, id: None }
    2292: Text { content: "\"Please explain or provide additional information to support your response to the above question.\"\u{a0} " }
    2293: EndTextStyle
    2294: Text { content: "When additional information is requested, please provide your answer(s) on a separate sheet of paper with the corresponding questionnaire number indicated, and type or print your answers legibly.\u{a0}\u{a0}You may omit any sections marked “optional” and be sure to double check your application before submission.\u{a0} " }
    2295: StartTextStyle { kind: Bold, id: None }
    2296: Text { content: "NOTE:\u{a0} The Questionnaire answer sheet\u{a0}is six pages long -- all six pages MUST be submitted\u{a0}even when the number\u{a0}of\u{a0}questions does not exceed page 5.\u{a0} In this case, please complete the top of Page 6 with your social security number and the vacancy ID number.\u{a0} " }
    2297: EndTextStyle
    2298: EndParagraph
    2299: StartParagraph { alignment: None, id: None }
    2300: Text { content: "You may submit the " }
    2301: StartLink { href: "http://www.opm.gov/forms/pdf_fill/opm1203fx.pdf", id: None, title: None }
    2302: StartTextStyle { kind: Underline, id: None }
    2303: StartTextStyle { kind: TextColor(Rgb { b: 102, g: 0, r: 0 }), id: None }
    2304: Text { content: "Form 1203-FX" }
    2305: EndTextStyle
    2306: EndTextStyle
    2307: EndLink
    2308: Text { content: ", resume and any supporting documents by fax." }
    2309: EndParagraph
    2310: StartParagraph { alignment: None, id: None }
    2311: Text { content: "If you " }
    2312: StartTextStyle { kind: Underline, id: None }
    2313: Text { content: "are" }
    2314: EndTextStyle
    2315: Text { content: " faxing a Form 1203-FX, " }
    2316: StartTextStyle { kind: Underline, id: None }
    2317: Text { content: "do not use a separate cover sheet" }
    2318: EndTextStyle
    2319: Text { content: ".\u{a0} Simply make sure the Form 1203-FX is on top of any other documents you are faxing." }
    2320: EndParagraph
    2321: StartParagraph { alignment: None, id: None }
    2322: StartTextStyle { kind: Bold, id: None }
    2323: Text { content: "If you are faxing any documents " }
    2324: EndTextStyle
    2325: StartTextStyle { kind: Bold, id: None }
    2326: StartTextStyle { kind: Underline, id: None }
    2327: Text { content: "without" }
    2328: EndTextStyle
    2329: EndTextStyle
    2330: StartTextStyle { kind: Bold, id: None }
    2331: Text { content: " the Form 1203-FX" }
    2332: EndTextStyle
    2333: Text { content: " on top, you MUST use the special cover page.\u{a0} Print the pre-populated cover page on the upload documents screen of Application Manager, or you may click this link ( " }
    2334: StartLink { href: "http://staffing.opm.gov/pdf/usascover.pdf", id: None, title: None }
    2335: StartTextStyle { kind: Underline, id: None }
    2336: StartTextStyle { kind: TextColor(Rgb { b: 102, g: 0, r: 0 }), id: None }
    2337: Text { content: "http://staffing." }
    2338: EndTextStyle
    2339: EndTextStyle
    2340: EndLink
    2341: StartLink { href: "http://staffing.opm.gov/pdf/usascover.pdf", id: None, title: None }
    2342: StartTextStyle { kind: Underline, id: None }
    2343: StartTextStyle { kind: TextColor(Rgb { b: 102, g: 0, r: 0 }), id: None }
    2344: Text { content: "opm.gov/pdf/usascover.pdf" }
    2345: EndTextStyle
    2346: EndTextStyle
    2347: EndLink
    2348: Text { content: "\u{a0}) to print a blank copy of the cover page.\u{a0} When faxing documents, follow the\u{a0}procedures outlined below:" }
    2349: EndParagraph
    2350: EndUnorderedListItem
    2351: StartUnorderedListItem { id: Some("9"), level: 0, style_type: Disc }
    2352: StartParagraph { alignment: None, id: None }
    2353: Text { content: "Include the 8-character Vacancy Identification Number " }
    2354: Text { content: "VN201385" }
    2355: Text { content: " " }
    2356: EndParagraph
    2357: EndUnorderedListItem
    2358: StartUnorderedListItem { id: Some("9"), level: 0, style_type: Disc }
    2359: StartParagraph { alignment: None, id: None }
    2360: Text { content: "Provide your Social Security Number and full name in the spaces provided or we will not be able to associate your document(s) with the rest of your application. " }
    2361: EndParagraph
    2362: EndUnorderedListItem
    2363: StartUnorderedListItem { id: Some("9"), level: 0, style_type: Disc }
    2364: StartParagraph { alignment: None, id: None }
    2365: Text { content: "You may submit multiple documents for the same vacancy announcement using one cover page." }
    2366: EndParagraph
    2367: StartParagraph { alignment: None, id: None }
    2368: Text { content: "Fax your cover page and documents to " }
    2369: StartTextStyle { kind: Bold, id: None }
    2370: Text { content: "1-478-757-3144" }
    2371: EndTextStyle
    2372: Text { content: "." }
    2373: Text { content: "\u{a0}" }
    2374: EndParagraph
    2375: StartParagraph { alignment: None, id: None }
    2376: Text { content: "Be sure to fill it out completely and clearly.\u{a0} Place your documents in the following order:\u{a0}US Government Application Cover Page;\u{a0} Resume or OF 612 (Application for Employment);\u{a0}Other required application materials." }
    2377: EndParagraph
    2378: StartParagraph { alignment: None, id: None }
    2379: Text { content: "The fax number is 1-478-757-3144.\u{a0} Feed all documents into your fax machine top first so that we receive them right-side up.\u{a0} If you fax your documents using any other cover sheet, you\u{a0}may not receive consideration." }
    2380: EndParagraph
    2381: StartParagraph { alignment: None, id: None }
    2382: StartTextStyle { kind: Bold, id: None }
    2383: Text { content: "Mailed, e-mailed or hand delivered applications will not be accepted." }
    2384: EndTextStyle
    2385: Text { content: "\u{a0} If you are unable to upload your documents after completing the Occupational Questionnaire online, you may FAX your documents (resume, transcripts, etc.) as instructed above." }
    2386: EndParagraph
    2387: EndUnorderedListItem
    2388: EndTableCell
    2389: EndTableRow
    2390: StartTableRow { id: None }
    2391: StartTableCell { colspan: None, id: None, rowspan: None }
    2392: StartParagraph { alignment: None, id: None }
    2393: LineBreak
    2394: LineBreak
    2395: StartTextStyle { kind: Bold, id: None }
    2396: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    2397: Text { content: "Required Documents:" }
    2398: EndTextStyle
    2399: EndTextStyle
    2400: EndParagraph
    2401: EndTableCell
    2402: EndTableRow
    2403: StartTableRow { id: None }
    2404: StartTableCell { colspan: None, id: None, rowspan: None }
    2405: StartParagraph { alignment: None, id: None }
    2406: Text { content: "All of the government forms mentioned in the above statements can be downloaded from the following web address:\u{a0} " }
    2407: StartLink { href: "http://www.opm.gov/forms", id: None, title: None }
    2408: StartTextStyle { kind: Underline, id: None }
    2409: StartTextStyle { kind: TextColor(Rgb { b: 102, g: 0, r: 0 }), id: None }
    2410: Text { content: "www.opm.gov/forms" }
    2411: EndTextStyle
    2412: EndTextStyle
    2413: EndLink
    2414: Text { content: "\u{a0}or obtained at the Human Resources Management Office of the duty station." }
    2415: EndParagraph
    2416: StartParagraph { alignment: None, id: None }
    2417: EndParagraph
    2418: EndTableCell
    2419: EndTableRow
    2420: StartTableRow { id: None }
    2421: StartTableCell { colspan: None, id: None, rowspan: None }
    2422: StartParagraph { alignment: None, id: None }
    2423: LineBreak
    2424: LineBreak
    2425: StartTextStyle { kind: Bold, id: None }
    2426: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    2427: Text { content: "Contact Information:" }
    2428: EndTextStyle
    2429: EndTextStyle
    2430: EndParagraph
    2431: EndTableCell
    2432: EndTableRow
    2433: StartTableRow { id: None }
    2434: StartTableCell { colspan: None, id: None, rowspan: None }
    2435: StartParagraph { alignment: None, id: None }
    2436: Text { content: "VHA Nationwide DEU " }
    2437: LineBreak
    2438: Text { content: "Phone: (607)664-4940 " }
    2439: LineBreak
    2440: Text { content: "Fax: (478)757-3144 " }
    2441: LineBreak
    2442: Text { content: "Email: vhabandeu2@va.gov " }
    2443: LineBreak
    2444: LineBreak
    2445: Text { content: "Or write:" }
    2446: LineBreak
    2447: Text { content: "WNY Health Care System DEU Bath" }
    2448: LineBreak
    2449: Text { content: "PLEASE DO NOT MAIL APPLICATIONS" }
    2450: LineBreak
    2451: Text { content: "APPLY ONLINE OR FAX ONLY" }
    2452: LineBreak
    2453: Text { content: "Thank you, DE 14810 " }
    2454: LineBreak
    2455: Text { content: "USA " }
    2456: LineBreak
    2457: Text { content: "Fax: (478)757-3144 " }
    2458: EndParagraph
    2459: EndTableCell
    2460: EndTableRow
    2461: StartTableRow { id: None }
    2462: StartTableCell { colspan: None, id: None, rowspan: None }
    2463: StartParagraph { alignment: None, id: None }
    2464: LineBreak
    2465: LineBreak
    2466: StartTextStyle { kind: Bold, id: None }
    2467: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    2468: Text { content: "What To Expect Next:" }
    2469: EndTextStyle
    2470: EndTextStyle
    2471: EndParagraph
    2472: EndTableCell
    2473: EndTableRow
    2474: StartTableRow { id: None }
    2475: StartTableCell { colspan: None, id: None, rowspan: None }
    2476: StartParagraph { alignment: None, id: None }
    2477: StartTextStyle { kind: Bold, id: None }
    2478: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 255 }), id: None }
    2479: Text { content: "WHAT HAPPENS NEXT?" }
    2480: EndTextStyle
    2481: EndTextStyle
    2482: EndParagraph
    2483: StartParagraph { alignment: None, id: None }
    2484: Text { content: "Your resume and supporting documentation will be compared to your responses to the\u{a0}Assessment Questionnaire.\u{a0} The questionnaire is designed to capture the desired knowledge, skills, and abilities for this position.\u{a0} The evaluation you receive is based on your responses to the questionnaire and is a measure of the degree to which your background matches the knowledge, skills, and abilities required of this position." }
    2485: EndParagraph
    2486: StartParagraph { alignment: None, id: None }
    2487: Text { content: "If your application does not support your responses to the questionnaire, or if you are not able to provide verifying documentation, it may affect your evaluation or result in your name being removed from further consideration." }
    2488: EndParagraph
    2489: StartParagraph { alignment: None, id: None }
    2490: Text { content: "If you are eligible for veterans' preference, you will be given preference based on the documentation you submit.\u{a0} Please see the \"" }
    2491: StartTextStyle { kind: Bold, id: None }
    2492: Text { content: "Veterans Information" }
    2493: EndTextStyle
    2494: Text { content: "\" section of this announcement for details." }
    2495: EndParagraph
    2496: StartParagraph { alignment: None, id: None }
    2497: Text { content: "This office will " }
    2498: StartTextStyle { kind: Bold, id: None }
    2499: Text { content: "not" }
    2500: EndTextStyle
    2501: Text { content: " contact\u{a0}you to discuss missing or illegible documents.\u{a0}" }
    2502: EndParagraph
    2503: StartParagraph { alignment: None, id: None }
    2504: Text { content: "Once your qualifications have been evaluated, your application will be assigned a numeric score.\u{a0} Candidates will be ranked in score order with appropriate points added for veterans' preference.\u{a0}" }
    2505: EndParagraph
    2506: StartParagraph { alignment: None, id: None }
    2507: StartTextStyle { kind: Bold, id: None }
    2508: Text { content: "An ELECTRONIC\u{a0}NOTIFICATION\u{a0}LETTER will be sent to applicants who provide an e-mail address" }
    2509: EndTextStyle
    2510: Text { content: ".\u{a0} If you do not provide an e-mail address, you\u{a0}will receive a notification letter via the U.S. Postal Service.\u{a0} Normal processing time is\u{a0}" }
    2511: StartTextStyle { kind: Bold, id: None }
    2512: Text { content: "4 - 6 weeks" }
    2513: EndTextStyle
    2514: Text { content: ".\u{a0} This office is responsible for initial evaluation " }
    2515: StartTextStyle { kind: Bold, id: None }
    2516: Text { content: "ONLY" }
    2517: EndTextStyle
    2518: Text { content: ".\u{a0} Facilities are responsible for contacting eligible applicants thereafter." }
    2519: EndParagraph
    2520: EndTableCell
    2521: EndTableRow
    2522: EndTable
    2523: StartParagraph { alignment: None, id: None }
    2524: EndParagraph
    2525: EndTableCell
