    2034: StartParagraph { alignment: None, id: None }
    2035: Text { content: "The\u{a0}average hours worked per week.\u{a0} Full-time work is considered to be 35-40 hours of work per week.\u{a0} Part-time experience will be credited on the basis of time actually spent in appropriate activities.\u{a0} Applicants wishing to receive credit for such experience must indicate clearly the number of hours a week spent in such employment" }
    2036: EndParagraph
    2037: EndUnorderedListItem
    2038: StartUnorderedListItem { id: Some("6"), level: 1, style_type: Disc }
    2039: StartParagraph { alignment: None, id: None }
    2040: Text { content: "Your supervisor's name and phone number (indicate if we may call your supervisor);" }
    2041: EndParagraph
    2042: EndUnorderedListItem
    2043: StartUnorderedListItem { id: Some("6"), level: 1, style_type: Disc }
    2044: StartParagraph { alignment: None, id: None }
    2045: Text { content: "A description of your duties that is sufficiently detailed to document the level of your experience.\u{a0} If the position is (was) with the Federal government (military\u{a0}or civilian), state the series and grade or pay grade (rank) and the date of last promotion" }
