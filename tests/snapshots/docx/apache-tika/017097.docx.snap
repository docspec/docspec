    1282: StartParagraph { alignment: None, id: None }
    1283: LineBreak
    1284: StartTextStyle { kind: Bold, id: None }
    1285: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1286: Text { content: "How To Apply:" }
    1287: EndTextStyle
    1288: EndTextStyle
    1289: EndParagraph
    1290: EndTableCell
    1291: EndTableRow
    1292: StartTableRow { id: None }
    1293: StartTableCell { colspan: None, id: None, rowspan: None }
    1294: StartParagraph { alignment: None, id: None }
    1295: StartTextStyle { kind: Bold, id: None }
    1296: Text { content: "PLEASE NOTE:\u{a0} " }
    1297: EndTextStyle
    1298: EndParagraph
    1299: StartUnorderedListItem { id: Some("4"), level: 0, style_type: Disc }
    1300: StartParagraph { alignment: None, id: None }
    1301: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1302: Text { content: "It is " }
    1303: EndTextStyle
    1304: StartTextStyle { kind: Italic, id: None }
    1305: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 255 }), id: None }
    1306: Text { content: "your responsibility " }
    1307: EndTextStyle
    1308: EndTextStyle
    1309: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1310: Text { content: "to insure that all application materials are " }
    1311: EndTextStyle
    1312: StartTextStyle { kind: Bold, id: None }
    1313: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1314: Text { content: "RECEIVED" }
    1315: EndTextStyle
    1316: EndTextStyle
    1317: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1318: Text { content: "\u{a0}by 11:59 p.m. Eastern Standard Time on the closing date of the announcement\u{a0}(Wednesday, July 30, 2008) in order to be considered.\u{a0} We cannot be responsible for incompatible software, illegible fax transmissions, interruptions in internet service, etc.\u{a0} " }
    1319: EndTextStyle
    1320: EndParagraph
    1321: EndUnorderedListItem
    1322: StartUnorderedListItem { id: Some("4"), level: 0, style_type: Disc }
    1323: StartParagraph { alignment: None, id: None }
    1324: Text { content: "You must submit a complete application package.\u{a0} Failure to provide complete information may result in your not receiving consideration for this position. " }
    1325: EndParagraph
    1326: EndUnorderedListItem
    1327: StartUnorderedListItem { id: Some("4"), level: 0, style_type: Disc }
    1328: StartParagraph { alignment: None, id: None }
    1329: Text { content: "You must submit your assessment questionnaire online (through Application Manager) " }
    1330: StartTextStyle { kind: Bold, id: None }
    1331: StartTextStyle { kind: Underline, id: None }
    1332: Text { content: "or" }
    1333: EndTextStyle
    1334: EndTextStyle
    1335: Text { content: "\u{a0} on " }
    1336: StartLink { href: "http://www.opm.gov/forms/pdf_fill/opm1203fx.pdf", id: None, title: None }
    1337: StartTextStyle { kind: Underline, id: None }
    1338: StartTextStyle { kind: TextColor(Rgb { b: 102, g: 0, r: 0 }), id: None }
    1339: Text { content: "OPM Form 1203-FX" }
    1340: EndTextStyle
    1341: EndTextStyle
    1342: EndLink
    1343: Text { content: " (and faxed).\u{a0} " }
    1344: StartTextStyle { kind: Bold, id: None }
    1345: StartTextStyle { kind: Italic, id: None }
    1346: Text { content: "Do not\u{a0}send printouts of your Application Manager Questionnaire Answers" }
    1347: EndTextStyle
    1348: EndTextStyle
    1349: Text { content: ".\u{a0} If you fax your application and/or documentation, please keep a copy of your fax transmittal receipt for future verification, if necessary. " }
    1350: EndParagraph
    1351: EndUnorderedListItem
    1352: StartUnorderedListItem { id: Some("4"), level: 0, style_type: Disc }
    1353: StartParagraph { alignment: None, id: None }
    1354: Text { content: "If you upload your documents using Application Manager, " }
    1355: StartTextStyle { kind: Bold, id: None }
    1356: Text { content: "DO NOT FAX" }
    1357: EndTextStyle
    1358: Text { content: " the same documents.\u{a0} To verify\u{a0}that your uploaded\u{a0}documents have been processed, please wait one hour to ensure they have cleared the virus scan.\u{a0} You can then verify that your uploaded documents are attached to your application by\u{a0}checking the \"" }
    1359: StartTextStyle { kind: Bold, id: None }
    1360: StartTextStyle { kind: Italic, id: None }
    1361: Text { content: "Details" }
    1362: EndTextStyle
    1363: EndTextStyle
    1364: Text { content: "\" tab of your Application Manager account (" }
    1365: StartLink { href: "https://applicationmanager.org/", id: None, title: None }
    1366: StartTextStyle { kind: Underline, id: None }
    1367: StartTextStyle { kind: TextColor(Rgb { b: 102, g: 0, r: 0 }), id: None }
    1368: Text { content: "https://applicationmanager.org" }
    1369: EndTextStyle
    1370: EndTextStyle
    1371: EndLink
    1372: Text { content: " ) for this vacancy announcement.\u{a0} Your documents will display under the \"" }
    1373: StartTextStyle { kind: Bold, id: None }
    1374: StartTextStyle { kind: Italic, id: None }
    1375: Text { content: "Details" }
    1376: EndTextStyle
    1377: EndTextStyle
    1378: Text { content: "\" tab in the Document area.\u{a0} " }
    1379: EndParagraph
    1380: EndUnorderedListItem
    1381: StartUnorderedListItem { id: Some("4"), level: 0, style_type: Disc }
    1382: StartParagraph { alignment: None, id: None }
    1383: Text { content: "You will not be contacted for additional information.\u{a0} " }
    1384: StartTextStyle { kind: Bold, id: None }
    1385: Text { content: "DO NOT" }
    1386: EndTextStyle
    1387: Text { content: " contact our offices for verification of receipt or status reports - we do not provide this information. " }
    1388: EndParagraph
    1389: EndUnorderedListItem
    1390: StartUnorderedListItem { id: Some("4"), level: 0, style_type: Disc }
    1391: StartParagraph { alignment: None, id: None }
    1392: Text { content: "Your application materials will not be returned.\u{a0} Do not submit original documents that you may need in the future. " }
    1393: EndParagraph
    1394: EndUnorderedListItem
    1395: StartUnorderedListItem { id: Some("4"), level: 0, style_type: Disc }
    1396: StartParagraph { alignment: None, id: None }
    1397: Text { content: "Your application must be completed on-line or faxed. " }
    1398: StartTextStyle { kind: Bold, id: None }
    1399: Text { content: "This\u{a0}office does not accept applications by electronic mail (e-mail), regular mail, or in person." }
    1400: EndTextStyle
    1401: Text { content: "\u{a0} " }
    1402: EndParagraph
    1403: StartParagraph { alignment: None, id: None }
    1404: EndParagraph
    1405: StartParagraph { alignment: None, id: None }
    1406: StartTextStyle { kind: Bold, id: None }
    1407: Text { content: "Applying for this position is as easy as 1, 2, 3..." }
    1408: EndTextStyle
    1409: EndParagraph
    1410: StartParagraph { alignment: None, id: None }
    1411: Text { content: "Just by following three steps, you will submit a complete application package and receive consideration for this position.\u{a0} Be sure to follow the steps carefully and complete all three.\u{a0} Each\u{a0}step is described in detail below." }
    1412: EndParagraph
    1413: EndUnorderedListItem
    1414: StartOrderedListItem { id: Some("5"), level: 0, start: Some(1), style_type: Decimal }
    1415: StartParagraph { alignment: None, id: None }
    1416: Text { content: "Your responses to the" }
    1417: StartTextStyle { kind: Bold, id: None }
    1418: Text { content: " Assessment Questionnaire, " }
    1419: EndTextStyle
    1420: StartTextStyle { kind: Italic, id: None }
    1421: Text { content: "(which may be completed\u{a0}electronically or on the " }
    1422: EndTextStyle
    1423: StartLink { href: "http://www.opm.gov/forms/pdf_fill/opm1203fx.pdf", id: None, title: None }
    1424: StartTextStyle { kind: Italic, id: None }
    1425: StartTextStyle { kind: Underline, id: None }
    1426: StartTextStyle { kind: TextColor(Rgb { b: 102, g: 0, r: 0 }), id: None }
    1427: Text { content: "OPM Form 1203FX" }
    1428: EndTextStyle
    1429: EndTextStyle
    1430: EndTextStyle
    1431: EndLink
    1432: StartTextStyle { kind: Italic, id: None }
    1433: Text { content: " and faxed)," }
    1434: EndTextStyle
    1435: Text { content: "\u{a0} " }
    1436: EndParagraph
    1437: EndOrderedListItem
    1438: StartOrderedListItem { id: Some("5"), level: 0, start: None, style_type: Decimal }
    1439: StartParagraph { alignment: None, id: None }
    1440: Text { content: "Your" }
    1441: StartTextStyle { kind: Bold, id: None }
    1442: Text { content: " resume\u{a0}" }
    1443: EndTextStyle
    1444: Text { content: "or" }
    1445: StartTextStyle { kind: Bold, id: None }
    1446: Text { content: " OF-612\u{a0} " }
    1447: EndTextStyle
    1448: Text { content: "(" }
    1449: StartTextStyle { kind: Italic, id: None }
    1450: Text { content: "which may be completed\u{a0}electronically, uploaded, or faxed), and" }
    1451: EndTextStyle
    1452: EndParagraph
    1453: EndOrderedListItem
    1454: StartOrderedListItem { id: Some("5"), level: 0, start: None, style_type: Decimal }
    1455: StartParagraph { alignment: None, id: None }
    1456: StartTextStyle { kind: Bold, id: None }
    1457: Text { content: "Other documents" }
    1458: EndTextStyle
    1459: Text { content: " specified in this job announcement (" }
    1460: StartTextStyle { kind: Italic, id: None }
    1461: Text { content: "which may be uploaded or faxed" }
    1462: EndTextStyle
    1463: Text { content: ")." }
    1464: EndParagraph
    1465: StartParagraph { alignment: None, id: None }
    1466: Text { content: "Use " }
    1467: StartTextStyle { kind: Italic, id: None }
    1468: Text { content: "Application Manager" }
    1469: EndTextStyle
    1470: Text { content: " for convenience and quickest processing.\u{a0} Track your progress to a " }
    1471: StartTextStyle { kind: Italic, id: None }
    1472: Text { content: "Complete" }
    1473: EndTextStyle
    1474: Text { content: " Application Package using " }
    1475: StartTextStyle { kind: Italic, id: None }
    1476: Text { content: "My Application Packages" }
    1477: EndTextStyle
    1478: Text { content: " checklist and status displays in Application Manager.\u{a0} Your Application Package status must be " }
    1479: StartTextStyle { kind: Italic, id: None }
    1480: Text { content: "Complete" }
    1481: EndTextStyle
    1482: Text { content: " by 11:59 p.m. EST on Wednesday, July 30, 2008." }
    1483: EndParagraph
    1484: StartParagraph { alignment: None, id: None }
    1485: StartTextStyle { kind: Bold, id: None }
    1486: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 192 }), id: None }
    1487: Text { content: "STEP 1:" }
    1488: EndTextStyle
    1489: EndTextStyle
    1490: StartTextStyle { kind: Bold, id: None }
    1491: Text { content: "\u{a0} " }
    1492: EndTextStyle
    1493: EndParagraph
    1494: StartParagraph { alignment: None, id: None }
    1495: Text { content: "Complete and submit the\u{a0}" }
    1496: StartTextStyle { kind: Bold, id: None }
    1497: Text { content: "Assessment Questionnaire" }
    1498: EndTextStyle
    1499: Text { content: ". The questionnaire\u{a0}" }
    1500: StartTextStyle { kind: Bold, id: None }
    1501: Text { content: "must" }
    1502: EndTextStyle
    1503: Text { content: " be completed and submitted\u{a0}in order to receive consideration for this position." }
    1504: EndParagraph
    1505: StartParagraph { alignment: None, id: None }
    1506: Text { content: "PLEASE NOTE:\u{a0} We highly encourage you to complete the Assessment Questionnaire online as it is the most efficient way to process your responses.\u{a0} Using paper application forms may delay the processing of your application.\u{a0} If you are unable to complete the\u{a0}Assessment Questionnaire online, go to STEP\u{a0}3 of this announcement and refer to the alternatives described under \"" }
    1507: StartTextStyle { kind: Bold, id: None }
    1508: Text { content: "Alternative Methods for Completing\u{a0}the Application Package" }
    1509: EndTextStyle
    1510: Text { content: "\"\u{a0} " }
    1511: EndParagraph
    1512: StartParagraph { alignment: None, id: None }
    1513: Text { content: "You must provide responses to all required questions. Be sure to double check your application before submission and click on \"" }
    1514: StartTextStyle { kind: Bold, id: None }
    1515: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 255 }), id: None }
    1516: Text { content: "SUBMIT" }
    1517: EndTextStyle
    1518: EndTextStyle
    1519: Text { content: "\" when it is complete.\u{a0} Your application is not transmitted to us until " }
    1520: StartTextStyle { kind: Bold, id: None }
    1521: StartTextStyle { kind: Underline, id: None }
    1522: Text { content: "you" }
    1523: EndTextStyle
    1524: EndTextStyle
    1525: StartTextStyle { kind: Bold, id: None }
    1526: Text { content: " " }
    1527: EndTextStyle
    1528: StartTextStyle { kind: Bold, id: None }
    1529: StartTextStyle { kind: Underline, id: None }
    1530: Text { content: "submit" }
    1531: EndTextStyle
    1532: EndTextStyle
    1533: StartTextStyle { kind: Bold, id: None }
    1534: Text { content: " " }
    1535: EndTextStyle
    1536: StartTextStyle { kind: Bold, id: None }
    1537: StartTextStyle { kind: Underline, id: None }
    1538: Text { content: "it" }
    1539: EndTextStyle
    1540: EndTextStyle
    1541: Text { content: "." }
    1542: EndParagraph
    1543: StartParagraph { alignment: None, id: None }
    1544: Text { content: "To\u{a0}complete your\u{a0}Assessment Questionnaire online, click the following link:" }
    1545: EndParagraph
    1546: StartParagraph { alignment: None, id: None }
    1547: StartLink { href: "https://ApplicationManager.org/Login.aspx?VacancyID=201385", id: None, title: None }
    1548: StartTextStyle { kind: Underline, id: None }
    1549: StartTextStyle { kind: TextColor(Rgb { b: 102, g: 0, r: 0 }), id: None }
    1550: Text { content: "Online Questionnaire" }
    1551: EndTextStyle
    1552: EndTextStyle
    1553: EndLink
    1554: EndParagraph
    1555: StartParagraph { alignment: None, id: None }
    1556: Text { content: "or enter " }
    1557: StartLink { href: "https://applicationmanager.org/", id: None, title: None }
    1558: StartTextStyle { kind: Underline, id: None }
    1559: StartTextStyle { kind: TextColor(Rgb { b: 102, g: 0, r: 0 }), id: None }
    1560: Text { content: "https://ApplicationManager.org" }
    1561: EndTextStyle
    1562: EndTextStyle
    1563: EndLink
    1564: Text { content: "\u{a0} You can save your work and come back later.\u{a0} To return to Application Manager at any time by simply going back to this web address.\u{a0} " }
    1565: EndParagraph
    1566: StartParagraph { alignment: None, id: None }
    1567: Text { content: "The\u{a0}Assessment Questionnaire must be completed and submitted by 11:59 p.m.\u{a0}EST on Wednesday, July 30, 2008." }
    1568: EndParagraph
    1569: StartParagraph { alignment: None, id: None }
    1570: StartTextStyle { kind: Bold, id: None }
    1571: Text { content: "ASSESSMENT\u{a0}QUESTIONNAIRE" }
    1572: EndTextStyle
    1573: EndParagraph
    1574: StartParagraph { alignment: None, id: None }
    1575: StartTextStyle { kind: Bold, id: None }
    1576: Text { content: "Social Security Number" }
    1577: EndTextStyle
    1578: EndParagraph
    1579: StartParagraph { alignment: None, id: None }
    1580: Text { content: "Enter your Social Security Number in the space indicated.\u{a0} Providing your Social Security Number is voluntary, however we cannot process your application without it." }
    1581: EndParagraph
    1582: StartParagraph { alignment: None, id: None }
    1583: LineBreak
    1584: StartTextStyle { kind: Bold, id: None }
    1585: Text { content: "Vacancy Identification Number" }
    1586: EndTextStyle
    1587: EndParagraph
    1588: StartParagraph { alignment: None, id: None }
    1589: Text { content: "VN201385" }
    1590: EndParagraph
    1591: StartParagraph { alignment: None, id: None }
    1592: Text { content: "\u{a0}" }
    1593: EndParagraph
    1594: StartParagraph { alignment: None, id: None }
    1595: LineBreak
    1596: StartTextStyle { kind: Bold, id: None }
    1597: Text { content: "1. Title of Job" }
    1598: EndTextStyle
    1599: EndParagraph
    1600: StartParagraph { alignment: None, id: None }
    1601: Text { content: "Program Support Assistant (Office Automation)\u{a0}" }
    1602: EndParagraph
    1603: StartParagraph { alignment: None, id: None }
    1604: Text { content: "\u{a0}" }
    1605: EndParagraph
    1606: StartParagraph { alignment: None, id: None }
    1607: LineBreak
    1608: StartTextStyle { kind: Bold, id: None }
    1609: Text { content: "2. Biographic Data" }
    1610: EndTextStyle
    1611: LineBreak
    1612: LineBreak
    1613: StartTextStyle { kind: Bold, id: None }
    1614: Text { content: "3. E-Mail Address" }
    1615: EndTextStyle
    1616: EndParagraph
    1617: StartParagraph { alignment: None, id: None }
    1618: Text { content: "Please enter your e-mail address in the space provided.\u{a0} If you do not provide an e-mail address you may not receive a notice of your results.\u{a0} " }
    1619: EndParagraph
    1620: StartParagraph { alignment: None, id: None }
