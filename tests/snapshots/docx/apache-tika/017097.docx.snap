     861: Image { alt: Some(""), decorative: false, id: None, title: None, asset: AssetDescriptor { asset_id: "zip://word/media/image6.png", content_type: "image/png", bytes: 122, sha256: "4ea80f3af52cd347d37562d2c3e644aa355dad8c4df11e8dd25fbd0119e521ba" } }
     862: EndParagraph
     863: EndTableCell
     864: StartTableCell { colspan: None, id: None, rowspan: None }
     865: StartParagraph { alignment: None, id: None }
     866: Image { alt: Some(""), decorative: false, id: None, title: None, asset: AssetDescriptor { asset_id: "zip://word/media/image6.png", content_type: "image/png", bytes: 122, sha256: "4ea80f3af52cd347d37562d2c3e644aa355dad8c4df11e8dd25fbd0119e521ba" } }
     867: EndParagraph
     868: EndTableCell
     869: StartTableCell { colspan: None, id: None, rowspan: None }
     870: StartTable { id: None }
     871: StartTableRow { id: None }
     872: StartTableCell { colspan: None, id: None, rowspan: None }
     873: StartParagraph { alignment: None, id: None }
     874: LineBreak
     875: StartTextStyle { kind: Bold, id: None }
     876: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     877: Text { content: "Qualifications:" }
     878: EndTextStyle
     879: EndTextStyle
     880: EndParagraph
     881: EndTableCell
     882: EndTableRow
     883: StartTableRow { id: None }
     884: StartTableCell { colspan: None, id: None, rowspan: None }
     885: StartParagraph { alignment: None, id: None }
     886: StartTextStyle { kind: Bold, id: None }
     887: StartTextStyle { kind: TextColor(Rgb { b: 255, g: 0, r: 0 }), id: None }
     888: Text { content: "To qualify for this position:" }
     889: EndTextStyle
     890: EndTextStyle
     891: EndParagraph
     892: StartParagraph { alignment: None, id: None }
     893: StartTextStyle { kind: Bold, id: None }
     894: StartTextStyle { kind: TextColor(Rgb { b: 37, g: 37, r: 37 }), id: None }
     895: Text { content: "BASIC REQUIREMENT: Must type 40 words per minute" }
     896: EndTextStyle
     897: EndTextStyle
     898: EndParagraph
     899: StartParagraph { alignment: Some(Center), id: None }
     900: StartTextStyle { kind: Bold, id: None }
     901: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 96, r: 255 }), id: None }
     902: Text { content: "~PLUS~" }
     903: EndTextStyle
     904: EndTextStyle
     905: EndParagraph
     906: StartParagraph { alignment: None, id: None }
     907: Text { content: "You must have one full\u{a0}year\u{a0}" }
     908: StartTextStyle { kind: Bold, id: None }
     909: Text { content: "specialized experience" }
     910: EndTextStyle
     911: Text { content: " equivalent to at least the GS-6 level.\u{a0} This experience must be close to the work of this job and has given you the particular knowledge, skills, and abilities required to successfully perform the duties of a Program Support Assistant (Office Automation).\u{a0} Examples of specialized experience may be working in a\u{a0}research setting, physician's office or health care facility where you were responsible for administrative support\u{a0}to\u{a0}clinical and/or administrative staff,\u{a0}compiling information for computer generated reports, taking meeting minutes, preparing proposals, managing the clerical processes of an office, etc.\u{a0} " }
     912: EndParagraph
     913: StartParagraph { alignment: None, id: None }
     914: StartTextStyle { kind: Italic, id: None }
     915: StartTextStyle { kind: TextColor(Rgb { b: 127, g: 0, r: 0 }), id: None }
     916: Text { content: "NOTE:\u{a0} A full year of\u{a0}work is considered to be 35-40 hours of work per week.\u{a0} Part-time experience will be credited on the basis of time actually spent in appropriate activities.\u{a0} Applicants wishing to receive credit for such experience must indicate clearly the nature of their duties and responsibilities in each position and the number of hours a week spent in such employment." }
     917: EndTextStyle
     918: EndTextStyle
     919: EndParagraph
     920: StartParagraph { alignment: None, id: None }
     921: Text { content: "Additional information on the qualification requirements is outlined in the OPM Qualifications Standards Handbook of General Schedule Positions.\u{a0} It is available for your review on OPM's web site at " }
     922: StartLink { href: "http://www.opm.gov/qualifications", id: None, title: None }
     923: StartTextStyle { kind: Underline, id: None }
     924: StartTextStyle { kind: TextColor(Rgb { b: 102, g: 0, r: 0 }), id: None }
     925: Text { content: "http://www.opm.gov/qualifications" }
     926: EndTextStyle
     927: EndTextStyle
     928: EndLink
     929: Text { content: " ." }
     930: EndParagraph
     931: StartParagraph { alignment: None, id: None }
     932: StartTextStyle { kind: Bold, id: None }
     933: Text { content: "Foreign Education" }
     934: EndTextStyle
     935: Text { content: ":\u{a0} To receive credit for education completed outside the United States, you must show proof that the education has been submitted to a private organization that specializes in the interpretation of foreign educational credentials and such education has been deemed at least equivalent to that gained in conventional U.S. education programs." }
     936: EndParagraph
     937: StartParagraph { alignment: None, id: None }
     938: StartTextStyle { kind: Bold, id: None }
     939: Text { content: "REQUIREMENTS" }
     940: EndTextStyle
     941: Text { content: " (Failure to comply may be grounds for withdrawal of an offer of employment, or dismissal after appointment):\u{a0} " }
     942: EndParagraph
     943: StartUnorderedListItem { id: Some("3"), level: 0, style_type: Disc }
     944: StartParagraph { alignment: None, id: None }
     945: Text { content: "Applicants must meet any physical, language, license or degree requirements. " }
     946: EndParagraph
     947: EndUnorderedListItem
     948: StartUnorderedListItem { id: Some("3"), level: 0, style_type: Disc }
     949: StartParagraph { alignment: None, id: None }
     950: Text { content: "Applicants must be citizens of the United States. " }
     951: EndParagraph
     952: EndUnorderedListItem
     953: StartUnorderedListItem { id: Some("3"), level: 0, style_type: Disc }
     954: StartParagraph { alignment: None, id: None }
     955: Text { content: "Applicants tentatively selected for certain designated positions may be subject to a random drug screening for illegal drug use.\u{a0} Applicants who refuse to be tested will be denied employment. " }
     956: EndParagraph
     957: EndUnorderedListItem
     958: StartUnorderedListItem { id: Some("3"), level: 0, style_type: Disc }
     959: StartParagraph { alignment: None, id: None }
     960: Text { content: "New Appointees may be subject to a probationary period. " }
     961: EndParagraph
     962: EndUnorderedListItem
     963: StartUnorderedListItem { id: Some("3"), level: 0, style_type: Disc }
     964: StartParagraph { alignment: None, id: None }
     965: Text { content: "New Appointees will be subject to a background investigation to determine suitability. " }
     966: EndParagraph
     967: EndUnorderedListItem
     968: StartUnorderedListItem { id: Some("3"), level: 0, style_type: Disc }
     969: StartParagraph { alignment: None, id: None }
     970: Text { content: "An\u{a0}OF-306, Declaration for Federal Employment (version dated January 2001),\u{a0}" }
     971: StartTextStyle { kind: Bold, id: None }
     972: StartTextStyle { kind: Italic, id: None }
     973: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 255 }), id: None }
     974: Text { content: "must be submitted prior to appointment.\u{a0}\u{a0} " }
     975: EndTextStyle
     976: EndTextStyle
     977: EndTextStyle
     978: StartTextStyle { kind: Italic, id: None }
     979: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     980: Text { content: "This form is available at " }
     981: EndTextStyle
     982: EndTextStyle
     983: StartLink { href: "http://www.opm.gov/forms/pdf_fill/of0306.pdf", id: None, title: None }
     984: StartTextStyle { kind: Italic, id: None }
     985: StartTextStyle { kind: Underline, id: None }
     986: StartTextStyle { kind: TextColor(Rgb { b: 102, g: 0, r: 0 }), id: None }
     987: Text { content: "www.opm.gov/forms/pdf_fill/of0306.pdf" }
     988: EndTextStyle
     989: EndTextStyle
     990: EndTextStyle
     991: EndLink
     992: StartTextStyle { kind: Italic, id: None }
     993: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     994: Text { content: ".\u{a0} " }
     995: EndTextStyle
     996: EndTextStyle
     997: EndParagraph
     998: EndUnorderedListItem
     999: EndTableCell
    1000: EndTableRow
    1001: StartTableRow { id: None }
