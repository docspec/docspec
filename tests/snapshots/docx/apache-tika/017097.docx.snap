    1951: Text { content: " " }
    1952: EndTextStyle
    1953: EndParagraph
    1954: StartParagraph { alignment: None, id: None }
    1955: Text { content: "Submit your\u{a0}choice of a Resume or an\u{a0}OF-612 -\u{a0}Optional Application for Federal Employment\u{a0}available at " }
    1956: StartLink { href: "http://www.opm.gov/forms/pdf_fill/of612.pdf", id: None, title: None }
    1957: StartTextStyle { kind: Underline, id: None }
    1958: StartTextStyle { kind: TextColor(Rgb { b: 102, g: 0, r: 0 }), id: None }
    1959: Text { content: "www.opm.gov/forms/pdf_fill/of612.pdf" }
    1960: EndTextStyle
    1961: EndTextStyle
    1962: EndLink
    1963: Text { content: "\u{a0}.\u{a0} We must receive a complete resume or OF 612 in order to determine your qualifications for this position." }
    1964: EndParagraph
