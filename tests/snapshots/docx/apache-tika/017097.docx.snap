    1100: StartTableCell { colspan: None, id: None, rowspan: None }
    1101: StartTable { id: None }
    1102: StartTableRow { id: None }
    1103: StartTableCell { colspan: None, id: None, rowspan: None }
    1104: StartParagraph { alignment: None, id: None }
    1105: LineBreak
    1106: StartTextStyle { kind: Bold, id: None }
    1107: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1108: Text { content: "Benefits:" }
    1109: EndTextStyle
    1110: EndTextStyle
    1111: EndParagraph
    1112: EndTableCell
    1113: EndTableRow
    1114: StartTableRow { id: None }
    1115: StartTableCell { colspan: None, id: None, rowspan: None }
    1116: StartParagraph { alignment: None, id: None }
    1117: Text { content: "The Department of Veterans Affairs offers a comprehensive benefits program that you can customize for your individual medical and financial needs.\u{a0} In addition to traditional \"dollars and cents\" benefits, we offer a range of benefits to help you balance life with the VA to life outside of work.\u{a0}\u{a0}For additional information about the many benefits of a career with the VA, please visit our \"" }
    1118: StartTextStyle { kind: Bold, id: None }
    1119: StartTextStyle { kind: Italic, id: None }
    1120: Text { content: "Benefits at a Glance" }
    1121: EndTextStyle
    1122: EndTextStyle
    1123: Text { content: "\" webpage at " }
    1124: StartLink { href: "http://www.va.gov/jobs/job_benefits/benefits.asp", id: None, title: None }
    1125: StartTextStyle { kind: Underline, id: None }
    1126: StartTextStyle { kind: TextColor(Rgb { b: 102, g: 0, r: 0 }), id: None }
    1127: Text { content: "http://www.va.gov/jobs/job_benefits/benefits.asp" }
    1128: EndTextStyle
    1129: EndTextStyle
    1130: EndLink
    1131: Text { content: "\u{a0}." }
    1132: EndParagraph
    1133: EndTableCell
    1134: EndTableRow
    1135: StartTableRow { id: None }
    1136: StartTableCell { colspan: None, id: None, rowspan: None }
    1137: StartParagraph { alignment: None, id: None }
    1138: LineBreak
    1139: StartTextStyle { kind: Bold, id: None }
    1140: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1141: Text { content: "Other Information:" }
    1142: EndTextStyle
    1143: EndTextStyle
    1144: EndParagraph
    1145: EndTableCell
    1146: EndTableRow
    1147: StartTableRow { id: None }
    1148: StartTableCell { colspan: None, id: None, rowspan: None }
    1149: StartParagraph { alignment: None, id: None }
    1150: StartTextStyle { kind: Bold, id: None }
    1151: StartTextStyle { kind: Underline, id: None }
    1152: Text { content: "Area of Consideration" }
    1153: EndTextStyle
    1154: EndTextStyle
    1155: Text { content: ":\u{a0} All citizens of the United States of America.\u{a0} Applications received under this announcement will be rated under competitive procedures in accordance with Office of Personnel Management examining regulations.\u{a0} [The Human Resources (HR) Office for the facility with this vacancy may be accepting applications separately under one or more special employment authorities, such as:\u{a0} Veterans Recruitment Appointment (VRA); Veterans Employment Opportunity Act (VEOA); hiring compensably disabled veterans with ratings of 30% or greater; hiring persons with disabilities; or reinstatement to, or transfer within, the Federal government.\u{a0} If so, you may find a\u{a0}separate announcement covering one or more of these special authorities\u{a0}on " }
    1156: StartLink { href: "http://www.usajobs.opm.gov/", id: None, title: None }
    1157: StartTextStyle { kind: Underline, id: None }
    1158: StartTextStyle { kind: TextColor(Rgb { b: 102, g: 0, r: 0 }), id: None }
    1159: Text { content: "http://www.usajobs.opm.gov/" }
    1160: EndTextStyle
    1161: EndTextStyle
    1162: EndLink
    1163: Text { content: ". \u{a0}You may also contact the facility's HR Office directly to inquire if applications are being accepted under any of the special authorities for which you are eligible.]\u{a0} " }
    1164: EndParagraph
    1165: StartParagraph { alignment: None, id: None }
    1166: Text { content: "\u{a0}" }
    1167: EndParagraph
    1168: StartParagraph { alignment: None, id: None }
    1169: Text { content: "For a fact sheet explaining how Federal jobs are filled, click on " }
    1170: StartLink { href: "http://www.usajobs.opm.gov/EI55.asp", id: None, title: None }
    1171: StartTextStyle { kind: Underline, id: None }
    1172: StartTextStyle { kind: TextColor(Rgb { b: 102, g: 0, r: 0 }), id: None }
    1173: Text { content: "http://www.usajobs.opm.gov/EI55.asp" }
    1174: EndTextStyle
    1175: EndTextStyle
    1176: EndLink
    1177: Text { content: ". " }
    1178: EndParagraph
    1179: StartParagraph { alignment: None, id: None }
    1180: Text { content: "\u{a0}" }
    1181: EndParagraph
    1182: StartParagraph { alignment: None, id: None }
    1183: StartTextStyle { kind: Bold, id: None }
    1184: StartTextStyle { kind: Underline, id: None }
    1185: Text { content: "Priority Consideration" }
    1186: EndTextStyle
    1187: EndTextStyle
    1188: Text { content: ":\u{a0} Individuals who have special priority selection rights under the Agency Career Transition Assistance Program (CTAP) or the Interagency Career Transition Assistance Program (ICTAP) must be well qualified for the position to receive consideration for special priority selection.\u{a0} CTAP and ICTAP eligibles will be considered well qualified if they attain an eligibility rating of 90.0 or higher, not including points for veterans' preference, from the facility with the vacancy." }
    1189: EndParagraph
    1190: StartParagraph { alignment: None, id: None }
    1191: Text { content: "\u{a0}" }
    1192: EndParagraph
    1193: StartParagraph { alignment: None, id: None }
    1194: Text { content: "Federal employees seeking CTAP/ICTAP eligibility must submit proof that they meet the requirements of 5 CFR 330.605 (a) for CTAP and 5 CFR 330.704 for ICTAP.\u{a0} This includes a copy of the agency notice, a copy of their most recent Performance Rating and a copy of their most recent SF-50 noting current position, grade level, and duty location.\u{a0} Please annotate your application to reflect that you are applying as a CTAP or ICTAP eligible." }
    1195: EndParagraph
    1196: EndTableCell
    1197: EndTableRow
    1198: EndTable
