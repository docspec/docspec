    1353: Text { content: "(5)" }
    1354: EndTextStyle
    1355: StartTextStyle { kind: Bold, id: None }
    1356: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1357: Text { content: " Official Transcripts" }
    1358: EndTextStyle
    1359: EndTextStyle
    1360: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1361: Text { content: " of undergraduate and graduate education " }
    1362: EndTextStyle
    1363: EndParagraph
    1364: StartParagraph { alignment: None, id: None }
    1365: EndParagraph
    1366: StartParagraph { alignment: None, id: None }
