    1371: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1372: Text { content: "(6) " }
    1373: EndTextStyle
    1374: StartTextStyle { kind: Bold, id: None }
    1375: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1376: Text { content: "Clinical Pastoral Education Certificates, " }
    1377: EndTextStyle
    1378: EndTextStyle
    1379: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1380: Text { content: "or a detailed description of the training you wish to have considered as equivalent.\u{a0}\u{a0} " }
    1381: EndTextStyle
    1382: EndParagraph
    1383: StartParagraph { alignment: None, id: None }
    1384: EndParagraph
    1385: StartParagraph { alignment: None, id: None }
    1386: EndParagraph
