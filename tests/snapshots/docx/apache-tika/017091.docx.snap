    1007: StartTextStyle { kind: Underline, id: None }
    1008: StartTextStyle { kind: TextColor(Rgb { b: 128, g: 128, r: 128 }), id: None }
    1009: Text { content: "How to Apply" }
    1010: EndTextStyle
    1011: EndTextStyle
    1012: EndParagraph
    1013: StartParagraph { alignment: None, id: None }
    1014: EndParagraph
    1015: StartParagraph { alignment: None, id: None }
    1016: StartTextStyle { kind: Bold, id: None }
    1017: StartTextStyle { kind: TextColor(Rgb { b: 33, g: 33, r: 99 }), id: None }
    1018: Text { content: "How to Apply:" }
    1019: EndTextStyle
    1020: EndTextStyle
    1021: EndParagraph
    1022: StartParagraph { alignment: None, id: None }
    1023: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1024: Text { content: "Mail your applications so it will be postmarked by closing date. If hand delivered, be sure your application is received by closing date." }
    1025: EndTextStyle
    1026: EndParagraph
    1027: StartParagraph { alignment: None, id: None }
    1028: EndParagraph
    1029: StartParagraph { alignment: None, id: None }
    1030: EndParagraph
    1031: StartParagraph { alignment: None, id: None }
    1032: StartTextStyle { kind: Bold, id: None }
    1033: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1034: Text { content: "\u{a0}\u{a0} Submit the following material to the National VA Chaplain Center:\u{a0} " }
    1035: EndTextStyle
    1036: EndTextStyle
    1037: EndParagraph
    1038: StartParagraph { alignment: None, id: None }
    1039: EndParagraph
    1040: StartParagraph { alignment: None, id: None }
    1041: EndParagraph
    1042: StartParagraph { alignment: None, id: None }
    1043: EndParagraph
    1044: StartParagraph { alignment: None, id: None }
    1045: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1046: Text { content: "(1) " }
    1047: EndTextStyle
    1048: StartTextStyle { kind: Bold, id: None }
    1049: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1050: Text { content: "An application form or resume" }
    1051: EndTextStyle
    1052: EndTextStyle
    1053: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1054: Text { content: " (federal forms OF-612 or SF-171 may be used but are not mandatory.)\u{a0} If you submit a resume, please be sure to include all of the following information:\u{a0} The country of which you are a citizen; the names and locations of colleges and universities attended, the degree(s) earned and the date(s); the dates and location of clinical pastoral education and other relevant training; and information about all relevant paid and unpaid experience, including: job title, duties and accomplishments, employer’s name and address, starting and ending dates (month and year), number of hours worked per week, and the salary (if any). " }
    1055: EndTextStyle
    1056: EndParagraph
    1057: StartParagraph { alignment: None, id: None }
    1058: EndParagraph
    1059: StartParagraph { alignment: None, id: None }
    1060: EndParagraph
    1061: StartParagraph { alignment: None, id: None }
    1062: EndParagraph
    1063: StartParagraph { alignment: None, id: None }
    1064: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1065: Text { content: "(2) " }
    1066: EndTextStyle
    1067: StartTextStyle { kind: Bold, id: None }
    1068: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1069: Text { content: "Declaration for Federal Employment " }
    1070: EndTextStyle
    1071: EndTextStyle
    1072: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1073: Text { content: "(form OF-306)" }
    1074: EndTextStyle
    1075: EndParagraph
    1076: StartParagraph { alignment: None, id: None }
    1077: EndParagraph
    1078: StartParagraph { alignment: None, id: None }
    1079: EndParagraph
    1080: StartParagraph { alignment: None, id: None }
    1081: EndParagraph
    1082: StartParagraph { alignment: None, id: None }
    1083: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1084: Text { content: "(3)" }
    1085: EndTextStyle
    1086: StartTextStyle { kind: Bold, id: None }
    1087: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1088: Text { content: " Ecclesiastical endorsement" }
    1089: EndTextStyle
    1090: EndTextStyle
    1091: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1092: Text { content: " dated within the past 12 months (" }
    1093: EndTextStyle
    1094: StartTextStyle { kind: Italic, id: None }
    1095: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1096: Text { content: "Most ecclesiastical endorsers will send endorsements directly to the Department of Veterans Affairs National Chaplain Center, in Hampton, Virginia.\u{a0} Applicants cannot be considered for positions until their endorsement is received at the National Chaplain Center).\u{a0}\u{a0} " }
    1097: EndTextStyle
    1098: EndTextStyle
    1099: EndParagraph
    1100: StartParagraph { alignment: None, id: None }
    1101: EndParagraph
    1102: StartParagraph { alignment: None, id: None }
    1103: EndParagraph
    1104: StartParagraph { alignment: None, id: None }
    1105: EndParagraph
    1106: StartParagraph { alignment: None, id: None }
    1107: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1108: Text { content: "(4) " }
    1109: EndTextStyle
    1110: StartTextStyle { kind: Bold, id: None }
    1111: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1112: Text { content: "If you are a veteran" }
    1113: EndTextStyle
    1114: EndTextStyle
    1115: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1116: Text { content: ":\u{a0} Submit a copy (the copy labeled “member copy 2”) of each of your military discharge forms (DD-214), and, if you are claiming 10-point preference, usually based on a service-connected disability, submit " }
    1117: EndTextStyle
    1118: StartTextStyle { kind: Bold, id: None }
    1119: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1120: Text { content: "SF-15" }
    1121: EndTextStyle
    1122: EndTextStyle
    1123: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1124: Text { content: "\u{a0}\u{a0} 'Claim for 10-point Veterans Preference' with the supporting documents as specified in the instructions on that form.\u{a0} For information on veterans preference see the Office of Personnel Management " }
    1125: EndTextStyle
    1126: StartTextStyle { kind: Bold, id: None }
    1127: StartTextStyle { kind: Italic, id: None }
    1128: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1129: Text { content: "Vetguide" }
    1130: EndTextStyle
    1131: EndTextStyle
    1132: EndTextStyle
    1133: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1134: Text { content: " at http://www.opm.gov/veterans/html/vetguide.htm" }
    1135: EndTextStyle
    1136: EndParagraph
    1137: StartParagraph { alignment: None, id: None }
