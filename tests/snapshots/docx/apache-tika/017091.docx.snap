     210: StartTextStyle { kind: TextColor(Rgb { b: 128, g: 128, r: 128 }), id: None }
     211: Text { content: "Duties" }
     212: EndTextStyle
     213: EndTextStyle
     214: EndParagraph
     215: StartParagraph { alignment: None, id: None }
     216: EndParagraph
     217: StartParagraph { alignment: None, id: None }
     218: StartTextStyle { kind: Bold, id: None }
     219: StartTextStyle { kind: TextColor(Rgb { b: 33, g: 33, r: 99 }), id: None }
     220: Text { content: "Major Duties:" }
     221: EndTextStyle
     222: EndTextStyle
     223: EndParagraph
     224: StartParagraph { alignment: None, id: None }
     225: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     226: Text { content: "Catholic Chaplains work at " }
     227: EndTextStyle
     228: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     229: Text { content: "Veterans" }
     230: EndTextStyle
     231: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     232: Text { content: " " }
     233: EndTextStyle
     234: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     235: Text { content: "Affairs" }
     236: EndTextStyle
     237: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     238: Text { content: " " }
     239: EndTextStyle
     240: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     241: Text { content: "Medical" }
     242: EndTextStyle
     243: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     244: Text { content: " " }
     245: EndTextStyle
     246: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     247: Text { content: "Centers" }
     248: EndTextStyle
     249: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     250: Text { content: ", Outpatient Clinics, and Domiciliaries throughout the " }
     251: EndTextStyle
     252: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     253: Text { content: "United States" }
     254: EndTextStyle
     255: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     256: Text { content: "." }
     257: EndTextStyle
     258: EndParagraph
     259: StartParagraph { alignment: None, id: None }
     260: EndParagraph
     261: StartParagraph { alignment: None, id: None }
     262: EndParagraph
     263: StartParagraph { alignment: None, id: None }
     264: EndParagraph
     265: StartParagraph { alignment: None, id: None }
     266: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     267: Text { content: "VA medical centers employ Catholic Chaplains in full time, part time, and intermittent positions.\u{a0}\u{a0}\u{a0} Intermittent positions have no prescheduled tour of duty.\u{a0} When filling GS-12 positions, facilities sometimes choose to hire an individual at GS-11 and to promote the individual to GS-12 after a year.\u{a0} " }
     268: EndTextStyle
     269: EndParagraph
     270: StartParagraph { alignment: None, id: None }
     271: EndParagraph
     272: StartParagraph { alignment: None, id: None }
     273: EndParagraph
     274: StartParagraph { alignment: None, id: None }
     275: EndParagraph
     276: StartParagraph { alignment: None, id: None }
     277: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     278: Text { content: "Chaplains at GS-11 provide complete religious ministry to veteran patients.\u{a0} They address religious, spiritual, moral, and ethical problems of patients, ministering to newly admitted, pre- and post-operative patients, the critically ill, and the families concerned.\u{a0} Catholic\u{a0}chaplains provide the full range of pastoral ministry and sacraments to Roman Catholic patients, including conscientious attention during emergency and crisis situations.\u{a0} Chaplains assure that all patients have opportunities for free exercise of religion and are protected from proselytizing.\u{a0} Chaplains provide guidance and religious instruction to individuals and groups; arrange for and conduct religious worship services in chapels and at other locations for patients unable to attend regular chapel services.\u{a0} Chaplains maintain cooperative relationships with " }
     279: EndTextStyle
     280: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     281: Text { content: "Medical" }
     282: EndTextStyle
     283: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     284: Text { content: " " }
     285: EndTextStyle
     286: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     287: Text { content: "Center" }
     288: EndTextStyle
     289: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     290: Text { content: " personnel and individuals and groups in the community.\u{a0} This work is carried out in a pluralistic environment; and each chaplain is sensitive to the religious needs of many separate religious denominations and faith groups." }
     291: EndTextStyle
     292: StartTextStyle { kind: Bold, id: None }
     293: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     294: Text { content: "\u{a0}\u{a0} " }
     295: EndTextStyle
     296: EndTextStyle
     297: EndParagraph
     298: StartParagraph { alignment: None, id: None }
     299: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     300: Text { content: "GS-12 chaplains provide comprehensive spiritual and pastoral care to patients and their families that encompasses all aspects of pastoral care including individual and group counseling, leading worship and ordinances, and patient/family education.\u{a0} Chaplains assure that all patients have opportunities for free exercise of religion, locating other chaplains and/or persons from the community to provide for patients’ religious needs as necessary.\u{a0} GS-12 chaplains collaborate with other health care professionals as part of interdisciplinary teams in assessing patient needs, planning and carrying out patient care; developing relationships with the larger community which support the " }
     301: EndTextStyle
     302: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     303: Text { content: "Medical" }
     304: EndTextStyle
     305: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     306: Text { content: " " }
     307: EndTextStyle
     308: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     309: Text { content: "Center" }
     310: EndTextStyle
     311: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     312: Text { content: " mission; and responding to emergency needs of patients and family members.\u{a0} Chaplains participate in educating health care staff and trainees about the role of chaplains and the importance of religion and spirituality in health and wellness.\u{a0} The work emphasizes an ecumenical, team approach to assignments." }
     313: EndTextStyle
     314: EndParagraph
     315: StartParagraph { alignment: None, id: None }
     316: EndParagraph
     317: StartParagraph { alignment: None, id: None }
     318: EndParagraph
     319: StartParagraph { alignment: None, id: None }
     320: StartTextStyle { kind: Underline, id: None }
     321: StartTextStyle { kind: TextColor(Rgb { b: 128, g: 128, r: 128 }), id: None }
     322: Text { content: "Qualifications and Evaluation" }
     323: EndTextStyle
     324: EndTextStyle
     325: EndParagraph
     326: StartParagraph { alignment: None, id: None }
     327: EndParagraph
     328: StartParagraph { alignment: None, id: None }
     329: StartTextStyle { kind: Bold, id: None }
     330: StartTextStyle { kind: TextColor(Rgb { b: 33, g: 33, r: 99 }), id: None }
     331: Text { content: "Qualifications:" }
     332: EndTextStyle
     333: EndTextStyle
     334: EndParagraph
     335: StartParagraph { alignment: None, id: None }
     336: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     337: Text { content: "Applicants must meet all of the following requirements:   " }
     338: EndTextStyle
     339: EndParagraph
     340: StartParagraph { alignment: None, id: None }
     341: EndParagraph
     342: StartParagraph { alignment: None, id: None }
     343: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     344: Text { content: "(1) Citizenship:\u{a0} The federal government gives strong priority to hiring " }
     345: EndTextStyle
     346: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     347: Text { content: "U.S." }
     348: EndTextStyle
     349: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     350: Text { content: " citizens.\u{a0} When no qualified " }
     351: EndTextStyle
     352: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     353: Text { content: "U.S." }
     354: EndTextStyle
     355: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     356: Text { content: " citizens are available certain non-citizens may be considered for VA chaplain positions.\u{a0} To be considered, non-citizens must meet the requirements of both immigration law and the appropriations act ban on paying certain non-citizens.\u{a0} The appropriations act ban does not apply to citizens of " }
     357: EndTextStyle
     358: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     359: Text { content: "Ireland" }
     360: EndTextStyle
     361: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     362: Text { content: ", " }
     363: EndTextStyle
     364: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     365: Text { content: "Israel" }
     366: EndTextStyle
     367: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     368: Text { content: ", or the Republic of the " }
     369: EndTextStyle
     370: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     371: Text { content: "Philippines" }
     372: EndTextStyle
     373: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     374: Text { content: ", or to nationals of those countries allied with the " }
     375: EndTextStyle
     376: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     377: Text { content: "United States" }
     378: EndTextStyle
     379: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     380: Text { content: " in the current defense effort (this includes countries in NATO).\u{a0}\u{a0}\u{a0}   Further information is available on-line at:\u{a0} http://www.opm.gov/employ/html/Citizen.htm\u{a0}\u{a0}\u{a0}   " }
     381: EndTextStyle
     382: EndParagraph
     383: StartParagraph { alignment: None, id: None }
     384: EndParagraph
     385: StartParagraph { alignment: None, id: None }
     386: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     387: Text { content: "(2) Ecclesiastical Endorsement: \u{a0}Must possess ecclesiastical endorsement, dated within the past 12 months, from the Roman Catholic Archdiocese for the Military Services in " }
     388: EndTextStyle
     389: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     390: Text { content: "Washington" }
     391: EndTextStyle
     392: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     393: Text { content: ", " }
     394: EndTextStyle
     395: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     396: Text { content: "DC" }
     397: EndTextStyle
     398: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     399: Text { content: ".\u{a0}\u{a0} Ecclesiastical endorsement is the written official statement of the Archdiocese\u{a0}certifying that the applicant is in good standing as clergy,\u{a0}and that the individual is, in the opinion of the endorsing body, qualified to perform the full range of ministry required by Roman Catholic patients in the VA pluralistic setting.\u{a0} For further information about the process of seeking ecclesiastical endorsement,\u{a0}please phone Chaplain (Associate Director) Paul Holt at the " }
     400: EndTextStyle
     401: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     402: Text { content: "National VA Chaplain" }
     403: EndTextStyle
     404: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     405: Text { content: " " }
     406: EndTextStyle
     407: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     408: Text { content: "Center" }
     409: EndTextStyle
     410: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     411: Text { content: " at (757) 728-7063.  " }
     412: EndTextStyle
