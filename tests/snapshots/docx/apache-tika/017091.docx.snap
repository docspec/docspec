     156: StartParagraph { alignment: None, id: None }
     157: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     158: Text { content: "Applications will be accepted from US Citizens and " }
     159: EndTextStyle
     160: StartTextStyle { kind: Underline, id: None }
     161: StartTextStyle { kind: TextColor(Rgb { b: 255, g: 0, r: 0 }), id: None }
