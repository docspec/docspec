    1407: EndParagraph
    1408: StartParagraph { alignment: None, id: None }
    1409: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1410: Text { content: "(8) " }
    1411: EndTextStyle
    1412: StartTextStyle { kind: Bold, id: None }
    1413: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1414: Text { content: "Specification of the locations, grades, and work schedules for which you wish to be considered" }
    1415: EndTextStyle
    1416: EndTextStyle
    1417: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1418: Text { content: " (use the lists “Chaplain Grade and Schedule Options Desired” and “Department of Veterans Affairs Locations” that are on the VA Chaplain web site: " }
    1419: EndTextStyle
    1420: StartTextStyle { kind: Underline, id: None }
    1421: StartTextStyle { kind: TextColor(Rgb { b: 255, g: 0, r: 0 }), id: None }
    1422: Text { content: "www.va.gov" }
    1423: EndTextStyle
    1424: EndTextStyle
    1425: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1426: Text { content: ", or you may specify your preferences on a separate page.)\u{a0}\u{a0} " }
    1427: EndTextStyle
    1428: EndParagraph
    1429: StartParagraph { alignment: None, id: None }
    1430: EndParagraph
    1431: StartParagraph { alignment: None, id: None }
    1432: StartTextStyle { kind: Bold, id: None }
    1433: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1434: Text { content: "Forms may be obtained from the Human Resources Management Service at any VA Medical Center, or phone the National VA Chaplain Center:\u{a0} (757) 728-7069" }
    1435: EndTextStyle
    1436: EndTextStyle
    1437: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1438: Text { content: "." }
    1439: EndTextStyle
    1440: EndParagraph
    1441: StartParagraph { alignment: None, id: None }
    1442: EndParagraph
    1443: StartParagraph { alignment: None, id: None }
    1444: EndParagraph
    1445: StartParagraph { alignment: None, id: None }
    1446: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1447: Text { content: "Application mailed using government postage or through an internal federal government mail system will not be considered." }
    1448: EndTextStyle
    1449: EndParagraph
    1450: StartParagraph { alignment: None, id: None }
    1451: EndParagraph
    1452: StartParagraph { alignment: None, id: None }
    1453: EndParagraph
    1454: StartParagraph { alignment: None, id: None }
    1455: StartTextStyle { kind: Bold, id: None }
    1456: StartTextStyle { kind: TextColor(Rgb { b: 33, g: 33, r: 99 }), id: None }
    1457: Text { content: "Contact Information:" }
    1458: EndTextStyle
    1459: EndTextStyle
    1460: EndParagraph
    1461: StartParagraph { alignment: None, id: None }
    1462: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1463: Text { content: "\t" }
    1464: Text { content: "JOHN BATTEN" }
    1465: EndTextStyle
    1466: EndParagraph
    1467: StartParagraph { alignment: None, id: None }
    1468: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1469: Text { content: "\t" }
    1470: Text { content: "Phone: 757-728-7062" }
    1471: EndTextStyle
    1472: EndParagraph
    1473: StartParagraph { alignment: None, id: None }
    1474: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1475: Text { content: "\t" }
    1476: EndTextStyle
    1477: EndParagraph
    1478: StartParagraph { alignment: None, id: None }
    1479: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1480: Text { content: "\t" }
    1481: Text { content: "Or Write:" }
    1482: EndTextStyle
    1483: EndParagraph
    1484: StartParagraph { alignment: None, id: None }
    1485: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1486: Text { content: "\t" }
    1487: Text { content: "Department Of Veterans Affairs" }
    1488: EndTextStyle
    1489: EndParagraph
    1490: StartParagraph { alignment: None, id: None }
    1491: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1492: Text { content: "\t" }
    1493: Text { content: "National VA Chaplain Center (301/111C)" }
    1494: EndTextStyle
    1495: EndParagraph
    1496: StartParagraph { alignment: None, id: None }
    1497: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1498: Text { content: "\t" }
    1499: Text { content: "100 Emancipation Drive, Building 33" }
    1500: EndTextStyle
    1501: EndParagraph
    1502: StartParagraph { alignment: None, id: None }
    1503: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1504: Text { content: "\t" }
    1505: Text { content: "Hampton VA 23667 " }
    1506: EndTextStyle
    1507: EndParagraph
    1508: StartParagraph { alignment: None, id: None }
    1509: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1510: Text { content: "\t" }
    1511: Text { content: "US" }
    1512: EndTextStyle
    1513: EndParagraph
    1514: StartParagraph { alignment: None, id: None }
    1515: EndParagraph
    1516: StartParagraph { alignment: None, id: None }
    1517: EndParagraph
    1518: StartParagraph { alignment: None, id: None }
    1519: StartTextStyle { kind: Bold, id: None }
    1520: StartTextStyle { kind: TextColor(Rgb { b: 33, g: 33, r: 99 }), id: None }
    1521: Text { content: "What to Expect Next:" }
    1522: EndTextStyle
    1523: EndTextStyle
    1524: EndParagraph
    1525: StartParagraph { alignment: None, id: None }
    1526: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1527: Text { content: "Normally applicants will be notified of their rating in writing within three weeks after all required documents are received at the National VA Chaplain Center.\u{a0} Your application remains active for one year following rating by the Board.\u{a0} You may submit additional or updated information about your qualifications to the Board of Excepted Service Examiners once during the year.\u{a0} At the end of the year you may update your application and request us to extend your eligibility.\u{a0} You may change the locations, grade(s) and/or work schedules for which you wish to be considered as often as you wish by contacting the National Chaplain Center." }
    1528: EndTextStyle
    1529: EndParagraph
    1530: StartParagraph { alignment: None, id: None }
    1531: EndParagraph
    1532: StartParagraph { alignment: None, id: None }
    1533: EndParagraph
    1534: StartParagraph { alignment: None, id: None }
    1535: EndParagraph
    1536: StartParagraph { alignment: None, id: None }
    1537: StartTextStyle { kind: Bold, id: None }
    1538: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1539: Text { content: "HOW APPLICANTS ARE REFERRED AND CONSIDERED FOR VACANCIES:" }
    1540: EndTextStyle
    1541: EndTextStyle
    1542: EndParagraph
    1543: StartParagraph { alignment: None, id: None }
    1544: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1545: Text { content: "When a VA health care facility wishes to hire a chaplain, it requests the National Chaplain Center for a list of applicants.\u{a0} The National Chaplain Center sends the facility a list of the qualified applicants who have indicated availability for that location, work schedule, and grade.\u{a0} If your application is complete in the National Chaplain Center on the day that a request is received, but has not yet been rated, the Board will rate your application before constructing the list of applicants.\u{a0} Applicants are listed in order of their numerical rating.\u{a0} The medical center must select from among the top three available applicants.\u{a0} The medical center will contact you directly if an interview is desired.\u{a0} " }
    1546: EndTextStyle
    1547: StartTextStyle { kind: Italic, id: None }
    1548: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1549: Text { content: "If you fail to" }
    1550: EndTextStyle
    1551: EndTextStyle
    1552: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1553: Text { content: " " }
    1554: EndTextStyle
    1555: StartTextStyle { kind: Italic, id: None }
    1556: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1557: Text { content: "reply to a phone call or letter from a medical center you may be eliminated from further consideration for the job.\u{a0} If you decline consideration for three positions for which you are referred, the National Chaplain Center will remove you from the list of active applicants.\u{a0} " }
    1558: EndTextStyle
    1559: EndTextStyle
    1560: EndParagraph
    1561: StartParagraph { alignment: None, id: None }
    1562: EndParagraph
    1563: StartParagraph { alignment: None, id: None }
    1564: EndParagraph
    1565: StartParagraph { alignment: None, id: None }
    1566: StartTextStyle { kind: Underline, id: None }
    1567: StartTextStyle { kind: TextColor(Rgb { b: 128, g: 128, r: 128 }), id: None }
    1568: Text { content: "EEO Policy Statement" }
    1569: EndTextStyle
    1570: EndTextStyle
    1571: EndParagraph
    1572: StartParagraph { alignment: None, id: None }
    1573: EndParagraph
    1574: StartParagraph { alignment: None, id: None }
    1575: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1576: Text { content: "The United States Government does not discriminate in employment on the basis of race, color, religion, sex, national origin, political affiliation, sexual orientation, marital status, disability, age, membership in an employee organization, or other non-merit factor." }
    1577: EndTextStyle
    1578: EndParagraph
    1579: StartParagraph { alignment: None, id: None }
    1580: EndParagraph
    1581: StartParagraph { alignment: None, id: None }
    1582: EndParagraph
    1583: StartParagraph { alignment: None, id: None }
    1584: StartTextStyle { kind: Underline, id: None }
    1585: StartTextStyle { kind: TextColor(Rgb { b: 128, g: 128, r: 128 }), id: None }
    1586: Text { content: "Reasonable Accommodation" }
    1587: EndTextStyle
    1588: EndTextStyle
    1589: EndParagraph
    1590: StartParagraph { alignment: None, id: None }
    1591: EndParagraph
    1592: StartParagraph { alignment: None, id: None }
    1593: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1594: Text { content: "Federal agencies must provide reasonable accommodation to applicants with disabilities where appropriate. Applicants requiring reasonable accommodation for any part of the application and hiring process should contact the hiring agency directly. Determinations on requests for reasonable accommodation will be made on a case-by-case basis." }
    1595: EndTextStyle
    1596: EndParagraph
    1597: StartParagraph { alignment: None, id: None }
    1598: EndParagraph
    1599: StartParagraph { alignment: None, id: None }
    1600: EndParagraph
    1601: StartParagraph { alignment: None, id: None }
    1602: StartTextStyle { kind: Underline, id: None }
    1603: StartTextStyle { kind: TextColor(Rgb { b: 128, g: 128, r: 128 }), id: None }
    1604: Text { content: "Veterans Information" }
    1605: EndTextStyle
    1606: EndTextStyle
    1607: EndParagraph
    1608: StartParagraph { alignment: None, id: None }
    1609: EndParagraph
    1610: StartParagraph { alignment: None, id: None }
    1611: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1612: Text { content: "Veterans who served on active duty in the U.S. Armed Forces and were separated under honorable conditions may be eligible for veterans’ preference. For service beginning after October 15, 1976, the veteran must have served the required length of time and have a Campaign Badge, Expeditionary Medal, a service-connected disability, or have served in the Gulf War between August 2, 1990, and January 2, 1992." }
    1613: EndTextStyle
    1614: EndParagraph
    1615: StartParagraph { alignment: None, id: None }
    1616: EndParagraph
    1617: StartParagraph { alignment: None, id: None }
    1618: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1619: Text { content: "The Veterans Employment Opportunity Act (VEOA) gives veterans access to job vacancies that might otherwise be closed to them. The law allows eligible veterans to compete for vacancies advertised under agency’s promotion procedures when the agency is seeking applications from outside of its own workforce." }
    1620: EndTextStyle
    1621: EndParagraph
    1622: StartParagraph { alignment: None, id: None }
    1623: EndParagraph
    1624: StartParagraph { alignment: None, id: None }
    1625: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1626: Text { content: "To claim veterans’ preference, veterans should be ready to provide a copy of their DD-214, Certificate of Release or Discharge from Active Duty, or other proof. Veterans with service connected disability and others claiming 10 point preference will need to submit Form SF-15, Application for 10-point Veterans’ Preference." }
    1627: EndTextStyle
    1628: EndParagraph
    1629: StartParagraph { alignment: None, id: None }
    1630: EndParagraph
    1631: StartParagraph { alignment: None, id: None }
    1632: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1633: Text { content: "For more specifics on all veterans employment issues such as Veterans preference or special appointing authorities see the VetGuide." }
    1634: EndTextStyle
    1635: EndParagraph
    1636: StartParagraph { alignment: None, id: None }
    1637: EndParagraph
    1638: StartParagraph { alignment: None, id: None }
    1639: EndParagraph
    1640: StartParagraph { alignment: None, id: None }
    1641: StartTextStyle { kind: Underline, id: None }
    1642: StartTextStyle { kind: TextColor(Rgb { b: 128, g: 128, r: 128 }), id: None }
    1643: Text { content: "Legal and Regulatory Guidance" }
    1644: EndTextStyle
    1645: EndTextStyle
    1646: EndParagraph
    1647: StartParagraph { alignment: None, id: None }
    1648: EndParagraph
    1649: StartParagraph { alignment: None, id: None }
    1650: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1651: Text { content: "Social Security Number - Your Social Security Number is requested under the authority of Executive Order 9397 to uniquely identify your records from those of other applicants who may have the same name. As allowed by law or Presidential directive, your Social Security Number is used to seek information about you from employers, schools, banks, and others who may know you. Failure to provide your Social Security Number on your application materials, will result in your application not being processed." }
    1652: EndTextStyle
    1653: EndParagraph
    1654: StartParagraph { alignment: None, id: None }
    1655: EndParagraph
    1656: StartParagraph { alignment: None, id: None }
    1657: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1658: Text { content: "Privacy Act - Privacy Act Notice (PL 93-579): The information requested here is used to determine qualifications for employment and is authorized under Title 5 U.S.C. 3302 and 3361." }
    1659: EndTextStyle
    1660: EndParagraph
    1661: StartParagraph { alignment: None, id: None }
    1662: EndParagraph
    1663: StartParagraph { alignment: None, id: None }
    1664: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1665: Text { content: "Signature - Before you are hired, you will be required to sign and certify the accuracy of the information in your application." }
    1666: EndTextStyle
    1667: EndParagraph
    1668: StartParagraph { alignment: None, id: None }
    1669: EndParagraph
    1670: StartParagraph { alignment: None, id: None }
    1671: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1672: Text { content: "False Statements - If you make a false statement in any part of your application, you may not be hired; you may be fired after you begin work; or you may be subject to fine, imprisonment, or other disciplinary action." }
    1673: EndTextStyle
    1674: EndParagraph
    1675: StartParagraph { alignment: None, id: None }
    1676: EndParagraph
    1677: StartParagraph { alignment: None, id: None }
    1678: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1679: Text { content: "Selective Service - If you are a male applicant born after December 31, 1959, you must certify that you have registered with the Selective Service System, or are exempt from having to do so under the Selective Service Law." }
    1680: EndTextStyle
    1681: EndParagraph
    1682: StartParagraph { alignment: None, id: None }
    1683: EndParagraph
    1684: StartParagraph { alignment: None, id: None }
    1685: EndParagraph
    1686: StartParagraph { alignment: Some(Center), id: None }
    1687: Text { content: "DEPARTMENT OF VETERANS AFFAIRS" }
    1688: EndParagraph
    1689: StartParagraph { alignment: Some(Center), id: None }
    1690: Text { content: "BOARD OF EXCEPTED SERVICE EXAMINERS" }
    1691: EndParagraph
    1692: StartParagraph { alignment: Some(Center), id: None }
    1693: EndParagraph
    1694: StartParagraph { alignment: Some(Center), id: None }
    1695: Text { content: "CHAPLAIN GRADE AND SCHEDULE OPTIONS DESIRED*" }
    1696: EndParagraph
    1697: StartParagraph { alignment: Some(Center), id: None }
    1698: EndParagraph
    1699: StartParagraph { alignment: None, id: None }
    1700: Text { content: "(submit this page with the other material requested in announcement BESE-A1)" }
    1701: EndParagraph
    1702: StartParagraph { alignment: None, id: None }
    1703: EndParagraph
    1704: StartParagraph { alignment: None, id: None }
    1705: Text { content: "GRADE(S) DESIRED (check as many as apply)" }
    1706: EndParagraph
    1707: StartParagraph { alignment: None, id: None }
    1708: EndParagraph
    1709: StartParagraph { alignment: None, id: None }
    1710: Text { content: "I wish to be considered for the following grade(s): " }
    1711: EndParagraph
    1712: StartParagraph { alignment: None, id: None }
    1713: EndParagraph
    1714: StartParagraph { alignment: None, id: None }
    1715: Text { content: "(   ) grade GS-11 (full performance level) (Please respond to rating factors A1 - A5 in your application)" }
    1716: EndParagraph
    1717: StartParagraph { alignment: None, id: None }
    1718: EndParagraph
    1719: StartParagraph { alignment: None, id: None }
    1720: Text { content: "(   ) grade GS-11 (with promotion potential to GS-12)  (Please respond to rating factors B1 - B5 in your application)" }
    1721: EndParagraph
    1722: StartParagraph { alignment: None, id: None }
    1723: EndParagraph
    1724: StartParagraph { alignment: None, id: None }
    1725: Text { content: "(   ) grade GS-12  )  (Please respond to rating factors B1 - B5 in your application)" }
    1726: EndParagraph
    1727: StartParagraph { alignment: None, id: None }
    1728: EndParagraph
    1729: StartParagraph { alignment: None, id: None }
    1730: Text { content: "(   ) all of the above  (Please respond to rating factors A1 - A5 and B2 - B5 in your application)" }
    1731: EndParagraph
    1732: StartParagraph { alignment: None, id: None }
    1733: EndParagraph
    1734: StartParagraph { alignment: None, id: None }
    1735: EndParagraph
    1736: StartParagraph { alignment: None, id: None }
    1737: Text { content: "WORK SCHEDULES DESIRED (check as many as apply)" }
    1738: EndParagraph
    1739: StartParagraph { alignment: None, id: None }
    1740: EndParagraph
    1741: StartParagraph { alignment: None, id: None }
    1742: Text { content: "I wish to be considered for the following work schedules:" }
    1743: EndParagraph
    1744: StartParagraph { alignment: None, id: None }
    1745: EndParagraph
    1746: StartParagraph { alignment: None, id: None }
    1747: Text { content: "(   ) full time (40 hours per week)" }
    1748: EndParagraph
    1749: StartParagraph { alignment: None, id: None }
    1750: EndParagraph
    1751: StartParagraph { alignment: None, id: None }
    1752: Text { content: "(   ) part time 30 to 35 hours per week" }
    1753: EndParagraph
    1754: StartParagraph { alignment: None, id: None }
    1755: EndParagraph
    1756: StartParagraph { alignment: None, id: None }
    1757: Text { content: "(   ) part time 24 to 29 hours per week" }
    1758: EndParagraph
    1759: StartParagraph { alignment: None, id: None }
    1760: EndParagraph
    1761: StartParagraph { alignment: None, id: None }
    1762: Text { content: "(   ) part time 16 to 23 hours per week" }
    1763: EndParagraph
    1764: StartParagraph { alignment: None, id: None }
    1765: EndParagraph
    1766: StartParagraph { alignment: None, id: None }
    1767: Text { content: "(   ) part time 10 to 15 hours per week" }
    1768: EndParagraph
    1769: StartParagraph { alignment: None, id: None }
    1770: EndParagraph
    1771: StartParagraph { alignment: None, id: None }
    1772: Text { content: "(   ) intermittent (no regularly scheduled hours)" }
    1773: EndParagraph
    1774: StartParagraph { alignment: None, id: None }
    1775: EndParagraph
    1776: StartParagraph { alignment: None, id: None }
    1777: EndParagraph
    1778: StartParagraph { alignment: None, id: None }
    1779: Text { content: "AVAILABILITY" }
    1780: EndParagraph
    1781: StartParagraph { alignment: None, id: None }
    1782: EndParagraph
    1783: StartParagraph { alignment: None, id: None }
    1784: Text { content: "If selected for employment I am available to report for work within ______ days after notification; or by ___________(date)   " }
    1785: EndParagraph
