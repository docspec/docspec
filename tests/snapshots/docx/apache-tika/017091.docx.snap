    1276: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1277: Text { content: "Declaration for Federal Employment " }
    1278: EndTextStyle
    1279: EndTextStyle
    1280: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1281: Text { content: "(form OF-306)" }
    1282: EndTextStyle
    1283: EndParagraph
    1284: StartParagraph { alignment: None, id: None }
    1285: EndParagraph
    1286: StartParagraph { alignment: None, id: None }
    1287: EndParagraph
    1288: StartParagraph { alignment: None, id: None }
    1289: EndParagraph
    1290: StartParagraph { alignment: None, id: None }
    1291: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1292: Text { content: "(3)" }
    1293: EndTextStyle
    1294: StartTextStyle { kind: Bold, id: None }
    1295: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1296: Text { content: " Ecclesiastical endorsement" }
    1297: EndTextStyle
    1298: EndTextStyle
    1299: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1300: Text { content: " dated within the past 12 months (" }
    1301: EndTextStyle
    1302: StartTextStyle { kind: Italic, id: None }
    1303: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1304: Text { content: "Most ecclesiastical endorsers will send endorsements directly to the Department of Veterans Affairs National Chaplain Center, in Hampton, Virginia.\u{a0} Applicants cannot be considered for positions until their endorsement is received at the National Chaplain Center).\u{a0}\u{a0} " }
    1305: EndTextStyle
    1306: EndTextStyle
    1307: EndParagraph
    1308: StartParagraph { alignment: None, id: None }
    1309: EndParagraph
    1310: StartParagraph { alignment: None, id: None }
    1311: EndParagraph
    1312: StartParagraph { alignment: None, id: None }
    1313: EndParagraph
    1314: StartParagraph { alignment: None, id: None }
    1315: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1316: Text { content: "(4) " }
    1317: EndTextStyle
    1318: StartTextStyle { kind: Bold, id: None }
    1319: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1320: Text { content: "If you are a veteran" }
    1321: EndTextStyle
    1322: EndTextStyle
    1323: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1324: Text { content: ":\u{a0} Submit a copy (the copy labeled “member copy 2”) of each of your military discharge forms (DD-214), and, if you are claiming 10-point preference, usually based on a service-connected disability, submit " }
    1325: EndTextStyle
    1326: StartTextStyle { kind: Bold, id: None }
    1327: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1328: Text { content: "SF-15" }
    1329: EndTextStyle
    1330: EndTextStyle
    1331: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1332: Text { content: "\u{a0}\u{a0} 'Claim for 10-point Veterans Preference' with the supporting documents as specified in the instructions on that form.\u{a0} For information on veterans preference see the Office of Personnel Management " }
    1333: EndTextStyle
    1334: StartTextStyle { kind: Bold, id: None }
    1335: StartTextStyle { kind: Italic, id: None }
    1336: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1337: Text { content: "Vetguide" }
    1338: EndTextStyle
    1339: EndTextStyle
    1340: EndTextStyle
    1341: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1342: Text { content: " at http://www.opm.gov/veterans/html/vetguide.htm" }
    1343: EndTextStyle
    1344: EndParagraph
    1345: StartParagraph { alignment: None, id: None }
    1346: EndParagraph
    1347: StartParagraph { alignment: None, id: None }
