     163: EndTextStyle
     164: EndTextStyle
     165: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     166: Text { content: " as allowed by appropriations.\u{a0} Non-citizens can only be hired when there are no qualified applicants available. " }
     167: EndTextStyle
     168: EndParagraph
     169: StartParagraph { alignment: None, id: None }
     170: EndParagraph
     171: StartParagraph { alignment: None, id: None }
     172: EndParagraph
     173: StartParagraph { alignment: None, id: None }
     174: StartTextStyle { kind: Bold, id: None }
     175: StartTextStyle { kind: TextColor(Rgb { b: 33, g: 33, r: 99 }), id: None }
     176: Text { content: "Job Summary:" }
     177: EndTextStyle
     178: EndTextStyle
     179: EndParagraph
     180: StartParagraph { alignment: None, id: None }
     181: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     182: Text { content: "The Department of Veterans Affairs has immediate openings for Roman Catholic Chaplains.\u{a0}\u{a0} Call the VA National Chaplain Center for information on current openings, and how to apply for\u{a0} continuing consideration as vacancies arise: 757-728-7069\u{a0} APPLICATIONS SUBMITTED UNDER THIS ANNOUNCEMENT WILL NOT\u{a0} BE CONSIDERED FOR THE FOLLOWING:\u{a0} (1) Contract or Fee-basis work at VA Health Care facilities.\u{a0}\u{a0} These types of utilization are\u{a0}not\u{a0}employment.\u{a0} Persons interested in contract or fee basis work must contact individual VA Medical Centers at which they wish to work.\u{a0} (2) Time-Limited employment to meet temporary needs.\u{a0} Individual VA Medical Centers recruit locally for these needs.\u{a0} Persons given time-limited appointments can\u{a0}not become permanent VA chaplains without competing in accordance with the provisions of this announcement\u{a0} (3) Supervisory chaplain positions.\u{a0} Supervisory positions are generally filled from within the Department of Veterans Affairs.\u{a0} However, when recruitment from outside VA is desired, such positions will be announced on USAJOBS.\u{a0} (4) Positions of Clinical Pastoral Education Supervisor.\u{a0} See announcement number BESE CPE-A " }
     183: EndTextStyle
     184: EndParagraph
     185: StartParagraph { alignment: None, id: None }
     186: EndParagraph
     187: StartParagraph { alignment: None, id: None }
     188: EndParagraph
     189: StartParagraph { alignment: None, id: None }
     190: StartTextStyle { kind: Bold, id: None }
     191: StartTextStyle { kind: TextColor(Rgb { b: 33, g: 33, r: 99 }), id: None }
     192: Text { content: "Key Requirements:" }
     193: EndTextStyle
     194: EndTextStyle
     195: EndParagraph
     196: StartParagraph { alignment: None, id: None }
     197: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     198: Text { content: "\t" }
     199: Text { content: "• Ecclesiastical Endorsement" }
     200: EndTextStyle
     201: EndParagraph
     202: StartParagraph { alignment: None, id: None }
     203: EndParagraph
     204: StartParagraph { alignment: None, id: None }
     205: EndParagraph
