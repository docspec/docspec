     416: StartParagraph { alignment: None, id: None }
     417: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     418: Text { content: "(3) Education: \u{a0}All applicants must possess the degree of Master of Divinity or equivalent educational qualifications.\u{a0} Equivalent educational qualifications means possession of a bachelor’s degree of at least 120 semester hours plus completion of not less than 70 semester hours of graduate course work which included all of the following: 20 semester hours in pastoral ministry; 20 semester hours in any combination of theology, ethics and philosophy of religion; 20 semester hours in the study of sacred writings, including the study of languages in which sacred writings are/were written;\u{a0} 10 semester hours in religious history and/or world religions.  To meet federal requirements, education must be from college(s), university(ies), or theological institution(s) that are accredited by an accrediting body recognized by the U.S. Department of Education.\u{a0} The U.S. Department of Education has a database of accredited institutions on the internet at:\u{a0} http://www.ed.gov/admins/finaid/accred/index.html  " }
     419: EndTextStyle
     420: EndParagraph
     421: StartParagraph { alignment: None, id: None }
     422: EndParagraph
     423: StartParagraph { alignment: None, id: None }
     424: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     425: Text { content: "(4)" }
     426: EndTextStyle
     427: StartTextStyle { kind: Bold, id: None }
     428: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     429: Text { content: " Clinical Pastoral Education (CPE): " }
     430: EndTextStyle
     431: EndTextStyle
     432: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     433: Text { content: "\u{a0}In addition to the education requirements, applicants must have completed at least " }
     434: EndTextStyle
     435: StartTextStyle { kind: Bold, id: None }
     436: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     437: Text { content: "2 units" }
     438: EndTextStyle
     439: EndTextStyle
     440: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     441: Text { content: " of Clinical Pastoral Education (CPE) [as defined by the Association for Clinical Pastoral Education (ACPE), the National Association of Catholic Chaplains (NACC), or the " }
     442: EndTextStyle
     443: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     444: Text { content: "College" }
     445: EndTextStyle
     446: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     447: Text { content: " of " }
     448: EndTextStyle
     449: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     450: Text { content: "Pastoral Supervision" }
     451: EndTextStyle
     452: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     453: Text { content: " and Psychotherapy (CPSP)]. " }
     454: EndTextStyle
     455: StartTextStyle { kind: Bold, id: None }
     456: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     457: Text { content: "\u{a0}\u{a0}800" }
     458: EndTextStyle
     459: EndTextStyle
     460: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     461: Text { content: " hours of supervised ministry in a formal training program which incorporated both ministry formation and pastoral care skills development may be substituted for the required CPE.\u{a0}\u{a0}Completion of a diaconal year after seminary may meet this requirement.\u{a0} We encourage you to contact Chaplain (Associate Director) Paul Holt at 757-728-7065 for further information.  " }
     462: EndTextStyle
     463: EndParagraph
     464: StartParagraph { alignment: None, id: None }
     465: EndParagraph
     466: StartParagraph { alignment: None, id: None }
     467: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     468: Text { content: "(5)" }
     469: EndTextStyle
     470: StartTextStyle { kind: Bold, id: None }
     471: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     472: Text { content: " Experience:\u{a0}\u{a0} To qualify for GS-11, you must have " }
     473: EndTextStyle
     474: EndTextStyle
     475: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     476: Text { content: "at least two years of professional experience, after completion of the M. Div. or equivalent, which has demonstrated both practical pastoral knowledge and skill, and ability to minister in a pluralistic setting.\u{a0}\u{a0} Supervised or guided pastoral experience completed" }
     477: EndTextStyle
     478: StartTextStyle { kind: Bold, id: None }
     479: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     480: Text { content: " during" }
     481: EndTextStyle
     482: EndTextStyle
     483: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     484: Text { content: " graduate professional education may be credited for up to one of the two years of experience.\u{a0}\u{a0} Part time experience is pro-rated by comparing the average number of hours worked to a 40 hour work week." }
     485: EndTextStyle
     486: StartTextStyle { kind: Bold, id: None }
     487: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     488: Text { content: "\u{a0} " }
     489: EndTextStyle
     490: EndTextStyle
     491: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     492: Text { content: "Completion of a doctoral degree directly related to pastoral ministry may be substituted for one year of experience.\u{a0}   " }
     493: EndTextStyle
     494: StartTextStyle { kind: Bold, id: None }
     495: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     496: Text { content: "For GS-12" }
     497: EndTextStyle
     498: EndTextStyle
     499: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     500: Text { content: "," }
     501: EndTextStyle
     502: StartTextStyle { kind: Bold, id: None }
     503: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     504: Text { content: " " }
     505: EndTextStyle
     506: EndTextStyle
     507: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     508: Text { content: "in addition to the requirements for GS-11, at least" }
     509: EndTextStyle
     510: StartTextStyle { kind: Bold, id: None }
     511: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     512: Text { content: " one year" }
     513: EndTextStyle
     514: EndTextStyle
     515: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     516: Text { content: " of professional experience, equivalent in complexity and responsibility to the GS-11 level, which has demonstrated " }
     517: EndTextStyle
     518: StartTextStyle { kind: Bold, id: None }
     519: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     520: Text { content: "all " }
     521: EndTextStyle
     522: EndTextStyle
     523: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     524: Text { content: "of the following:   (a) ability to serve as a consultant or expert to a interdisciplinary treatment team;   (b) in-depth knowledge of related professional fields, particularly in the behavioral sciences;   (c)\u{a0}understanding of, and ability to respond to, the particular concerns and issues pertaining to treatment of veterans;\u{a0}   (d) knowledge of the structure, regulations, practices, and programs of health care delivery systems;\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}   (e) Ability to interpret and apply a body of rules, regulations, policies, and procedures in professional practice; (f) ability to develop and maintain liaisons with a variety of outside organizations.\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}\u{a0}   " }
     525: EndTextStyle
     526: EndParagraph
     527: StartParagraph { alignment: None, id: None }
     528: EndParagraph
     529: StartParagraph { alignment: None, id: None }
     530: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     531: Text { content: "(6)" }
     532: EndTextStyle
     533: StartTextStyle { kind: Bold, id: None }
     534: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     535: Text { content: " English Language Competency:" }
     536: EndTextStyle
     537: EndTextStyle
     538: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     539: Text { content: " All applicants must be proficient in written and spoken English. " }
     540: EndTextStyle
     541: EndParagraph
     542: StartParagraph { alignment: None, id: None }
     543: EndParagraph
     544: StartParagraph { alignment: None, id: None }
     545: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     546: Text { content: "(7)" }
     547: EndTextStyle
     548: StartTextStyle { kind: Bold, id: None }
     549: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     550: Text { content: " Selective Service Registration: " }
     551: EndTextStyle
     552: EndTextStyle
     553: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     554: Text { content: "\u{a0}By law, all males born after December 31, 1959 must have registered with the selective service system (the draft) or have a valid exemption. " }
     555: EndTextStyle
     556: EndParagraph
     557: StartParagraph { alignment: None, id: None }
     558: EndParagraph
     559: StartParagraph { alignment: None, id: None }
     560: EndParagraph
     561: StartParagraph { alignment: None, id: None }
     562: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     563: Text { content: "Drug Testing - All non-VA applicants tentatively selected for VA employment in" }
     564: EndTextStyle
     565: EndParagraph
     566: StartParagraph { alignment: None, id: None }
     567: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     568: Text { content: "any position are subject to urinalysis to screen for illegal drug use prior to" }
     569: EndTextStyle
     570: EndParagraph
     571: StartParagraph { alignment: None, id: None }
     572: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     573: Text { content: "appointment. Applicants who refuse to be tested will be denied employment with" }
     574: EndTextStyle
     575: EndParagraph
     576: StartParagraph { alignment: None, id: None }
     577: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     578: Text { content: "the VA." }
     579: EndTextStyle
     580: EndParagraph
     581: StartParagraph { alignment: None, id: None }
     582: EndParagraph
     583: StartParagraph { alignment: None, id: None }
     584: EndParagraph
     585: StartParagraph { alignment: None, id: None }
     586: StartTextStyle { kind: Bold, id: None }
     587: StartTextStyle { kind: TextColor(Rgb { b: 33, g: 33, r: 99 }), id: None }
     588: Text { content: "How Will You Be Evaluated:" }
     589: EndTextStyle
     590: EndTextStyle
     591: EndParagraph
     592: StartParagraph { alignment: None, id: None }
     593: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     594: Text { content: "Once your qualifications have been evaluated, your application will be assigned a numeric score. Candidates will be ranked in score order with appropriate points added for " }
     595: EndTextStyle
     596: StartTextStyle { kind: Underline, id: None }
     597: StartTextStyle { kind: TextColor(Rgb { b: 255, g: 0, r: 0 }), id: None }
     598: Text { content: "veterans' preference" }
     599: EndTextStyle
     600: EndTextStyle
     601: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     602: Text { content: "." }
     603: EndTextStyle
     604: EndParagraph
     605: StartParagraph { alignment: None, id: None }
     606: EndParagraph
     607: StartParagraph { alignment: None, id: None }
     608: EndParagraph
     609: StartParagraph { alignment: None, id: None }
     610: EndParagraph
     611: StartParagraph { alignment: None, id: None }
     612: StartTextStyle { kind: Bold, id: None }
     613: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     614: Text { content: "RATING FACTORS FOR CHAPLAINS" }
     615: EndTextStyle
     616: EndTextStyle
     617: EndParagraph
     618: StartParagraph { alignment: None, id: None }
     619: EndParagraph
     620: StartParagraph { alignment: None, id: None }
     621: EndParagraph
     622: StartParagraph { alignment: None, id: None }
     623: EndParagraph
     624: StartParagraph { alignment: None, id: None }
     625: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     626: Text { content: "Qualified applicants will be evaluated on their possession of the factors listed below.\u{a0} Please describe your experience, education, training, awards and other specific accomplishments that demonstrate your possession of the rating factors for all the grade(s) for which you wish to be considered.\u{a0} Providing this information is voluntary; however, if you do not give give complete information you may receive less than full credit in the rating process.\u{a0} You may provide responses on separate sheets of bond paper.\u{a0} Your name and social security number should be on the top of each sheet." }
     627: EndTextStyle
     628: EndParagraph
     629: StartParagraph { alignment: None, id: None }
     630: EndParagraph
     631: StartParagraph { alignment: None, id: None }
     632: EndParagraph
     633: StartParagraph { alignment: None, id: None }
     634: EndParagraph
     635: StartParagraph { alignment: None, id: None }
     636: EndParagraph
     637: StartParagraph { alignment: None, id: None }
     638: EndParagraph
     639: StartParagraph { alignment: None, id: None }
     640: EndParagraph
     641: StartParagraph { alignment: None, id: None }
     642: StartTextStyle { kind: Bold, id: None }
     643: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     644: Text { content: "GS-11 (Full Performance Level)" }
     645: EndTextStyle
     646: EndTextStyle
     647: EndParagraph
     648: StartParagraph { alignment: None, id: None }
     649: EndParagraph
     650: StartParagraph { alignment: None, id: None }
     651: StartTextStyle { kind: Bold, id: None }
     652: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     653: Text { content: "A1. Ability to communicate orally" }
     654: EndTextStyle
     655: EndTextStyle
     656: EndParagraph
     657: StartParagraph { alignment: None, id: None }
     658: EndParagraph
     659: StartParagraph { alignment: None, id: None }
     660: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     661: Text { content: "Describe your accomplishments that demonstrate the breadth and complexity of oral communication that you have performed.\u{a0} (For example counseling, training, lecturing)\u{a0} Describe the most difficult communication tasks you have performed in your professional practice and in outside activities.\u{a0} " }
     662: EndTextStyle
     663: EndParagraph
     664: StartParagraph { alignment: None, id: None }
     665: EndParagraph
     666: StartParagraph { alignment: None, id: None }
     667: EndParagraph
     668: StartParagraph { alignment: None, id: None }
     669: EndParagraph
     670: StartParagraph { alignment: None, id: None }
     671: StartTextStyle { kind: Bold, id: None }
     672: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     673: Text { content: "A2. Ability to communicate in writing" }
     674: EndTextStyle
     675: EndTextStyle
     676: EndParagraph
     677: StartParagraph { alignment: None, id: None }
     678: EndParagraph
     679: StartParagraph { alignment: None, id: None }
     680: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     681: Text { content: "Describe the most difficult and complex written communication you have performed.\u{a0} Describe how you have incorporated written communication into your professional practice and outside activities." }
     682: EndTextStyle
     683: EndParagraph
     684: StartParagraph { alignment: None, id: None }
     685: EndParagraph
     686: StartParagraph { alignment: None, id: None }
     687: EndParagraph
     688: StartParagraph { alignment: None, id: None }
     689: StartTextStyle { kind: Bold, id: None }
     690: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     691: Text { content: "A3. Ability to deal effectively with others" }
     692: EndTextStyle
     693: EndTextStyle
     694: EndParagraph
     695: StartParagraph { alignment: None, id: None }
     696: EndParagraph
     697: StartParagraph { alignment: None, id: None }
     698: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     699: Text { content: "Describe your accomplishments in leading or supervising others.\u{a0} Describe achievements in mediating disputes, negotiating settlements, solving interpersonal problems, motivating and persuading others." }
     700: EndTextStyle
     701: EndParagraph
     702: StartParagraph { alignment: None, id: None }
     703: EndParagraph
     704: StartParagraph { alignment: None, id: None }
     705: EndParagraph
     706: StartParagraph { alignment: None, id: None }
     707: StartTextStyle { kind: Bold, id: None }
     708: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     709: Text { content: "A4. Ability to minister to persons from various social, cultural and racial backgrounds" }
     710: EndTextStyle
     711: EndTextStyle
     712: EndParagraph
     713: StartParagraph { alignment: None, id: None }
     714: EndParagraph
     715: StartParagraph { alignment: None, id: None }
     716: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     717: Text { content: "Describe your experience in relating with and ministering to clergy, patients, and others from various faith and value traditions.\u{a0} Describe any accomplishments in developing interfaith relationships." }
     718: EndTextStyle
     719: EndParagraph
     720: StartParagraph { alignment: None, id: None }
     721: EndParagraph
     722: StartParagraph { alignment: None, id: None }
     723: EndParagraph
     724: StartParagraph { alignment: None, id: None }
     725: StartTextStyle { kind: Bold, id: None }
     726: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     727: Text { content: "A5. Ability to provide or facilitate liturgical and sacramental ministry to persons from various religious backgrounds." }
     728: EndTextStyle
     729: EndTextStyle
     730: EndParagraph
     731: StartParagraph { alignment: None, id: None }
     732: EndParagraph
     733: StartParagraph { alignment: None, id: None }
     734: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     735: Text { content: "Describe your ministry experience and current professional practice that demonstrates your knowledge of various liturgical principles and practices " }
     736: EndTextStyle
     737: EndParagraph
     738: StartParagraph { alignment: None, id: None }
     739: EndParagraph
     740: StartParagraph { alignment: None, id: None }
     741: EndParagraph
     742: StartParagraph { alignment: None, id: None }
     743: EndParagraph
     744: StartParagraph { alignment: None, id: None }
     745: EndParagraph
     746: StartParagraph { alignment: None, id: None }
     747: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     748: Text { content: "GS-11 (potential 12) and/or GS-12" }
     749: EndTextStyle
     750: EndParagraph
     751: StartParagraph { alignment: None, id: None }
     752: EndParagraph
     753: StartParagraph { alignment: None, id: None }
     754: EndParagraph
     755: StartParagraph { alignment: None, id: None }
     756: StartTextStyle { kind: Bold, id: None }
     757: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     758: Text { content: "B1. Ability to communicate orally and in writing." }
     759: EndTextStyle
     760: EndTextStyle
     761: EndParagraph
     762: StartParagraph { alignment: None, id: None }
     763: EndParagraph
     764: StartParagraph { alignment: None, id: None }
     765: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     766: Text { content: "Describe your accomplishments in oral and written communication.\u{a0} Describe your use of these abilities in your professional experience in religious instruction, pastoral care, and participation in multidisciplinary teams/committees.\u{a0} List and describe any publications." }
     767: EndTextStyle
     768: EndParagraph
     769: StartParagraph { alignment: None, id: None }
     770: EndParagraph
     771: StartParagraph { alignment: None, id: None }
     772: EndParagraph
     773: StartParagraph { alignment: None, id: None }
     774: StartTextStyle { kind: Bold, id: None }
     775: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     776: Text { content: "B2.\u{a0} Ability to provide clinical pastoral care and counseling in a healthcare setting." }
     777: EndTextStyle
     778: EndTextStyle
     779: EndParagraph
     780: StartParagraph { alignment: None, id: None }
     781: EndParagraph
     782: StartParagraph { alignment: None, id: None }
     783: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     784: Text { content: "Describe in detail your experience in providing ministry in health-care settings.\u{a0} Describe the workplace, the type(s) of patients or clients served, and your participation as a member of multidisciplinary treatment team(s).\u{a0} Be sure to include any experience with veterans.\u{a0} List any relevant training, education and certifications.\u{a0} Describe your qualifications in any clinical specialties and attach supporting documentation. " }
     785: EndTextStyle
     786: EndParagraph
     787: StartParagraph { alignment: None, id: None }
     788: EndParagraph
     789: StartParagraph { alignment: None, id: None }
     790: StartTextStyle { kind: Bold, id: None }
     791: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     792: Text { content: "B3. Ability to provide ministry in a pluralistic setting" }
     793: EndTextStyle
     794: EndTextStyle
     795: EndParagraph
     796: StartParagraph { alignment: None, id: None }
     797: EndParagraph
     798: StartParagraph { alignment: None, id: None }
     799: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     800: Text { content: "Describe your experience in relating with clergy, patients, and others from various faith and value traditions.\u{a0} Describe any accomplishments in developing interfaith relationships.\u{a0} Describe your experience in ministering to persons from a variety of faith groups." }
     801: EndTextStyle
     802: EndParagraph
     803: StartParagraph { alignment: None, id: None }
     804: EndParagraph
     805: StartParagraph { alignment: None, id: None }
     806: StartTextStyle { kind: Bold, id: None }
     807: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     808: Text { content: "B4.\u{a0} Knowledge of worship principles and practices" }
     809: EndTextStyle
     810: EndTextStyle
     811: EndParagraph
     812: StartParagraph { alignment: None, id: None }
     813: EndParagraph
     814: StartParagraph { alignment: None, id: None }
     815: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     816: Text { content: "Describe your ministry experience and current professional practice that demonstrates your knowledge of various worship (liturgical) principles and practices." }
     817: EndTextStyle
     818: EndParagraph
     819: StartParagraph { alignment: None, id: None }
     820: EndParagraph
     821: StartParagraph { alignment: None, id: None }
     822: EndParagraph
     823: StartParagraph { alignment: None, id: None }
     824: StartTextStyle { kind: Bold, id: None }
     825: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     826: Text { content: "B5. Ability to establish relationships and deal effectively with others" }
     827: EndTextStyle
     828: EndTextStyle
     829: EndParagraph
     830: StartParagraph { alignment: None, id: None }
     831: EndParagraph
     832: StartParagraph { alignment: None, id: None }
     833: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     834: Text { content: "Describe your experiences in leading or supervising others.\u{a0} Give examples of accomplishments in mediating disputes and negotiating settlements.\u{a0} Describe your involvement in community and civic activities.\u{a0} Be sure to describe your relationships with professional associations, interdisciplinary teams, veterans organizations, fraternal organizations, etc." }
     835: EndTextStyle
     836: EndParagraph
     837: StartParagraph { alignment: None, id: None }
     838: EndParagraph
     839: StartParagraph { alignment: None, id: None }
     840: EndParagraph
     841: StartParagraph { alignment: None, id: None }
     842: EndParagraph
     843: StartParagraph { alignment: None, id: None }
     844: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     845: Text { content: "Persons who have completed a one-year Clinical Pastoral Education residency or fellowship at a Department of Veterans Affairs Medical Center, and who meet all VA chaplain qualification requirements, can be considered for jobs without a numerical rating. This is called “non-competitive consideration.” Veterans are given preference.\u{a0} This eligibility for non-competitive consideration lasts for one year after completion of the residency/fellowship." }
     846: EndTextStyle
     847: EndParagraph
     848: StartParagraph { alignment: None, id: None }
     849: EndParagraph
     850: StartParagraph { alignment: None, id: None }
     851: EndParagraph
     852: StartParagraph { alignment: None, id: None }
     853: StartTextStyle { kind: Underline, id: None }
     854: StartTextStyle { kind: TextColor(Rgb { b: 128, g: 128, r: 128 }), id: None }
     855: Text { content: "Benefits and Other Information" }
     856: EndTextStyle
     857: EndTextStyle
     858: EndParagraph
     859: StartParagraph { alignment: None, id: None }
     860: EndParagraph
     861: StartParagraph { alignment: None, id: None }
     862: StartTextStyle { kind: Bold, id: None }
     863: StartTextStyle { kind: TextColor(Rgb { b: 33, g: 33, r: 99 }), id: None }
     864: Text { content: "Benefits:" }
     865: EndTextStyle
     866: EndTextStyle
     867: EndParagraph
     868: StartParagraph { alignment: None, id: None }
     869: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     870: Text { content: "You may participate in the Federal Employees Health Benefits program, with costs shared with your employer. More info: " }
     871: EndTextStyle
     872: StartTextStyle { kind: Underline, id: None }
     873: StartTextStyle { kind: TextColor(Rgb { b: 255, g: 0, r: 0 }), id: None }
     874: Text { content: "http://www.usajobs.gov/jobextrainfo.asp#FEHB" }
     875: EndTextStyle
     876: EndTextStyle
     877: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     878: Text { content: "." }
     879: EndTextStyle
     880: EndParagraph
     881: StartParagraph { alignment: None, id: None }
     882: EndParagraph
     883: StartParagraph { alignment: None, id: None }
     884: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     885: Text { content: "Life insurance coverage is provided. More info: " }
     886: EndTextStyle
     887: StartTextStyle { kind: Underline, id: None }
     888: StartTextStyle { kind: TextColor(Rgb { b: 255, g: 0, r: 0 }), id: None }
     889: Text { content: "http://www.usajobs.gov/jobextrainfo.asp#life" }
     890: EndTextStyle
     891: EndTextStyle
     892: EndParagraph
     893: StartParagraph { alignment: None, id: None }
     894: EndParagraph
     895: StartParagraph { alignment: None, id: None }
     896: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     897: Text { content: "Long-Term Care Insurance is offered and carries into your retirement. More info: " }
     898: EndTextStyle
     899: StartTextStyle { kind: Underline, id: None }
     900: StartTextStyle { kind: TextColor(Rgb { b: 255, g: 0, r: 0 }), id: None }
     901: Text { content: "http://www.usajobs.gov/jobextrainfo.asp#ltci" }
     902: EndTextStyle
     903: EndTextStyle
     904: EndParagraph
     905: StartParagraph { alignment: None, id: None }
     906: EndParagraph
     907: StartParagraph { alignment: None, id: None }
     908: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     909: Text { content: "New employees are automatically covered by the Federal Employees Retirement System (FERS). If you are transferring from another agency and covered by CSRS, you may continue in this program. More info: " }
     910: EndTextStyle
     911: StartTextStyle { kind: Underline, id: None }
     912: StartTextStyle { kind: TextColor(Rgb { b: 255, g: 0, r: 0 }), id: None }
     913: Text { content: "http://www.usajobs.gov/jobextrainfo.asp#retr" }
     914: EndTextStyle
     915: EndTextStyle
     916: EndParagraph
     917: StartParagraph { alignment: None, id: None }
     918: EndParagraph
     919: StartParagraph { alignment: None, id: None }
     920: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     921: Text { content: "You will earn annual vacation leave. More info: " }
     922: EndTextStyle
     923: StartTextStyle { kind: Underline, id: None }
     924: StartTextStyle { kind: TextColor(Rgb { b: 255, g: 0, r: 0 }), id: None }
     925: Text { content: "http://www.usajobs.gov/jobextrainfo.asp#VACA" }
     926: EndTextStyle
     927: EndTextStyle
     928: EndParagraph
     929: StartParagraph { alignment: None, id: None }
     930: EndParagraph
     931: StartParagraph { alignment: None, id: None }
     932: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     933: Text { content: "You will earn sick leave. More info: " }
     934: EndTextStyle
     935: StartTextStyle { kind: Underline, id: None }
     936: StartTextStyle { kind: TextColor(Rgb { b: 255, g: 0, r: 0 }), id: None }
     937: Text { content: "http://www.usajobs.gov/jobextrainfo.asp#SKLV" }
     938: EndTextStyle
     939: EndTextStyle
     940: EndParagraph
     941: StartParagraph { alignment: None, id: None }
     942: EndParagraph
     943: StartParagraph { alignment: None, id: None }
     944: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     945: Text { content: "You will be paid for federal holidays that fall within your regularly scheduled tour of duty. More info: " }
     946: EndTextStyle
     947: StartTextStyle { kind: Underline, id: None }
     948: StartTextStyle { kind: TextColor(Rgb { b: 255, g: 0, r: 0 }), id: None }
     949: Text { content: "http://www.usajobs.gov/jobextrainfo.asp#HOLI" }
     950: EndTextStyle
     951: EndTextStyle
     952: EndParagraph
     953: StartParagraph { alignment: None, id: None }
     954: EndParagraph
     955: StartParagraph { alignment: None, id: None }
     956: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     957: Text { content: "Opportunities are available in numerous locations and employees may transfer to new locations to further their career goals. " }
     958: EndTextStyle
     959: EndParagraph
     960: StartParagraph { alignment: None, id: None }
     961: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     962: Text { content: "Selected applicants may qualify for credit towards annual leave accrual, based on prior non-federal or military service experience." }
     963: EndTextStyle
     964: EndParagraph
     965: StartParagraph { alignment: None, id: None }
     966: EndParagraph
     967: StartParagraph { alignment: None, id: None }
     968: EndParagraph
     969: StartParagraph { alignment: None, id: None }
     970: StartTextStyle { kind: Bold, id: None }
     971: StartTextStyle { kind: TextColor(Rgb { b: 33, g: 33, r: 99 }), id: None }
     972: Text { content: "Other Information:" }
     973: EndTextStyle
     974: EndTextStyle
     975: EndParagraph
     976: StartParagraph { alignment: None, id: None }
     977: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     978: Text { content: "This job is being filled by an alternative hiring process and is not in the competitive civil service." }
     979: EndTextStyle
     980: EndParagraph
     981: StartParagraph { alignment: None, id: None }
     982: EndParagraph
     983: StartParagraph { alignment: None, id: None }
     984: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     985: Text { content: "The materials you send with your application will not be returned." }
     986: EndTextStyle
     987: EndParagraph
     988: StartParagraph { alignment: None, id: None }
     989: EndParagraph
     990: StartParagraph { alignment: None, id: None }
     991: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     992: Text { content: "Send only those materials needed to evaluate your application. Please do not place your application in a notebook or binder." }
     993: EndTextStyle
     994: EndParagraph
     995: StartParagraph { alignment: None, id: None }
     996: EndParagraph
     997: StartParagraph { alignment: None, id: None }
     998: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
     999: Text { content: "You will be required to serve a\u{a0}trial period of 1 year. " }
    1000: EndTextStyle
    1001: EndParagraph
    1002: StartParagraph { alignment: None, id: None }
    1003: EndParagraph
    1004: StartParagraph { alignment: None, id: None }
    1005: EndParagraph
