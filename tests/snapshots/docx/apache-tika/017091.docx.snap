    1144: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1145: Text { content: "(5)" }
    1146: EndTextStyle
    1147: StartTextStyle { kind: Bold, id: None }
    1148: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1149: Text { content: " Official Transcripts" }
    1150: EndTextStyle
    1151: EndTextStyle
    1152: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1153: Text { content: " of undergraduate and graduate education " }
    1154: EndTextStyle
    1155: EndParagraph
    1156: StartParagraph { alignment: None, id: None }
    1157: EndParagraph
    1158: StartParagraph { alignment: None, id: None }
    1159: EndParagraph
    1160: StartParagraph { alignment: None, id: None }
    1161: EndParagraph
    1162: StartParagraph { alignment: None, id: None }
    1163: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1164: Text { content: "(6) " }
    1165: EndTextStyle
    1166: StartTextStyle { kind: Bold, id: None }
    1167: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1168: Text { content: "Clinical Pastoral Education Certificates, " }
    1169: EndTextStyle
    1170: EndTextStyle
    1171: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1172: Text { content: "or a detailed description of the training you wish to have considered as equivalent.\u{a0}\u{a0} " }
    1173: EndTextStyle
    1174: EndParagraph
    1175: StartParagraph { alignment: None, id: None }
    1176: EndParagraph
    1177: StartParagraph { alignment: None, id: None }
    1178: EndParagraph
    1179: StartParagraph { alignment: None, id: None }
    1180: EndParagraph
    1181: StartParagraph { alignment: None, id: None }
    1182: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1183: Text { content: "(7) " }
    1184: EndTextStyle
    1185: StartTextStyle { kind: Bold, id: None }
    1186: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1187: Text { content: "Narrative responses to the Chaplain rating factors" }
    1188: EndTextStyle
    1189: EndTextStyle
    1190: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1191: Text { content: "\u{a0}(you may respond on bond paper).\u{a0} " }
    1192: EndTextStyle
    1193: EndParagraph
    1194: StartParagraph { alignment: None, id: None }
    1195: EndParagraph
    1196: StartParagraph { alignment: None, id: None }
    1197: EndParagraph
    1198: StartParagraph { alignment: None, id: None }
    1199: EndParagraph
    1200: StartParagraph { alignment: None, id: None }
    1201: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1202: Text { content: "(8) " }
    1203: EndTextStyle
    1204: StartTextStyle { kind: Bold, id: None }
    1205: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1206: Text { content: "Specification of the locations, grades, and work schedules for which you wish to be considered" }
    1207: EndTextStyle
    1208: EndTextStyle
    1209: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1210: Text { content: " (use the lists “Chaplain Grade and Schedule Options Desired” and “Department of Veterans Affairs Locations” that are on the VA Chaplain Web site: " }
    1211: EndTextStyle
    1212: StartTextStyle { kind: Underline, id: None }
    1213: StartTextStyle { kind: TextColor(Rgb { b: 255, g: 0, r: 0 }), id: None }
    1214: Text { content: "www.va.gov/chaplain" }
    1215: EndTextStyle
    1216: EndTextStyle
    1217: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1218: Text { content: ", or you may specify your preferences on a separate page.)\u{a0}\u{a0} " }
    1219: EndTextStyle
    1220: EndParagraph
    1221: StartParagraph { alignment: None, id: None }
    1222: EndParagraph
    1223: StartParagraph { alignment: None, id: None }
    1224: StartTextStyle { kind: Bold, id: None }
    1225: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1226: Text { content: "Forms may be obtained from the Human Resources Management Service at any VA Medical Center, or phone the National VA Chaplain Center:\u{a0} (757) 728-7069" }
    1227: EndTextStyle
    1228: EndTextStyle
    1229: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
