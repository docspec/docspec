    1388: EndParagraph
    1389: StartParagraph { alignment: None, id: None }
    1390: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1391: Text { content: "(7) " }
    1392: EndTextStyle
    1393: StartTextStyle { kind: Bold, id: None }
    1394: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1395: Text { content: "Narrative responses to the Chaplain rating factors" }
    1396: EndTextStyle
    1397: EndTextStyle
    1398: StartTextStyle { kind: TextColor(Rgb { b: 0, g: 0, r: 0 }), id: None }
    1399: Text { content: "\u{a0} (you may respond on bond paper).\u{a0} " }
    1400: EndTextStyle
