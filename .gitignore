# Rust build artifacts
target/
/crates/*/target/

# Generated WASM packages. Nothing under these paths is tracked; wasm-pack also
# writes its own `pkg/.gitignore` containing `*`, but do not depend on that --
# these rules must stand on their own.
#
# The `crates/` entry is not a typo: wasm-pack resolves --out-dir relative to the
# CRATE directory, so `--out-dir crates/docspec-wasm/pkg` (a natural thing to
# type, since every other path in the docs is repo-relative) writes to
# crates/docspec-wasm/crates/docspec-wasm/pkg/.
/crates/docspec-wasm/pkg/
/crates/docspec-wasm/pkg-*/
/crates/docspec-wasm/crates/
# Anchored deliberately. A bare `*.wasm` matches at any depth, and this
# repository tracks binary fixtures through LFS, so it would silently refuse to
# stage a future .wasm fixture -- `git add` reporting success while adding
# nothing. Generated packages are already covered by the rules above and by
# `target/`; this only backstops a stray wasm-pack --out-dir inside the crate.
/crates/docspec-wasm/**/*.wasm

# Coverage artifacts
lcov.info
*.profraw
*.profdata

# Editor and IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Environment files
.env
.env.local

# Sisyphus orchestration state (local only)
.sisyphus/boulder.json
.sisyphus/evidence/
.sisyphus/notepads/
